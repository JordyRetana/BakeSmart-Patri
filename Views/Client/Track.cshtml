
@section Styles {
    <link rel="stylesheet" href="~/css/pages/client-track.css?v=20260905-real-route" />
}
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Seguimiento";
}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>

<div class="page-shell track-page track-page--loading" id="trackPage">
    <div class="page-header track-header">
        <div>
            <h1 class="track-title">
                <i class="fas fa-route"></i>
                Seguimiento inteligente del pedido
            </h1>
            <p class="text-muted track-subtitle">
                El mapa utiliza el origen configurado y la ubicacion real registrada para cada pedido.
            </p>
        </div>

        <div class="track-toolbar">
            <a class="btn btn-outline" href="/Client/Orders"><i class="fas fa-arrow-left"></i> Mis pedidos</a>
            <select id="trackOrderSelect" class="form-control track-select"></select>
        </div>
    </div>

    <section class="track-live-strip" aria-label="Estado actual de la entrega">
        <div class="track-live-icon"><i id="trackLiveIcon" class="fas fa-clock"></i></div>
        <div class="track-live-copy">
            <span id="trackLiveEyebrow">Actualización del pedido</span>
            <strong id="trackLiveTitle">Preparando seguimiento</strong>
            <small id="trackLiveDetail">Consultando el estado más reciente...</small>
        </div>
        <div class="track-live-progress" aria-label="Progreso del pedido">
            <div class="track-live-progress__meta"><span>Progreso</span><strong id="trackProgressValue">0%</strong></div>
            <div class="track-live-progress__rail"><span id="trackProgressBar"></span></div>
        </div>
    </section>

    <div class="grid grid-3 track-kpis">
        <div class="card metric-card">
            <div class="text-muted">Pedido</div>
            <h2 id="trackOrderId"></h2>
        </div>
        <div class="card metric-card">
            <div class="text-muted">Estado</div>
            <h2 id="trackStatus"></h2>
        </div>
        <div class="card metric-card">
            <div class="text-muted">Tipo de ruta</div>
            <h2 id="trackRouteType"></h2>
        </div>
    </div>

    <div class="track-layout">
        <div class="card track-map-card">
            <div class="track-map-header">
                <div>
                    <h3 class="track-section-title">Ruta de entrega</h3>
                    <div id="trackMeta" class="text-muted track-map-meta">Calculando ruta...</div>
                </div>

                <div class="map-legend">
                    <span><i class="fas fa-store"></i> Origen</span>
                    <span><i class="fas fa-motorcycle"></i> Última ubicación real</span>
                    <span><i class="fas fa-location-dot"></i> Destino</span>
                </div>
            </div>

            <div id="deliveryMap" class="delivery-map"></div>
        </div>

        <div class="track-side-stack">
            <div class="card">
                <div class="track-side-header">
                    <h3 class="track-section-title">Progreso del pedido</h3>
                    <span class="badge badge-info"><i class="fas fa-eye"></i> Solo lectura</span>
                </div>
                <div id="trackingTimeline" class="tracking-timeline"></div>
            </div>

            <div class="card">
            <h3 class="track-section-title track-summary-title">Resumen logistico</h3>
                <div id="trackingSummary" class="tracking-summary text-muted"></div>
            </div>
        </div>
    </div>
</div>



@section Scripts {
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script>
(() => {
    const page = document.getElementById('trackPage');
    const defaultOrigin = {
        name: 'BakeSmart Patri',
        address: '',
        city: 'San Jose',
        country: 'Costa Rica',
        lat: 9.9281,
        lng: -84.0907
    };
    const orderSelect = document.getElementById('trackOrderSelect');
    const userEmail = document.body.dataset.userEmail || '';
    let origin = sanitizeLocation(BakeSmartStore.geo.origin(), defaultOrigin);

    let map;
    let markers = [];
    let layers = [];
    let activeOrderId = null;
    let pageInitialized = false;

    function isValidCoordinate(lat, lng) {
        const latitude = Number(lat);
        const longitude = Number(lng);
        return Number.isFinite(latitude) &&
            Number.isFinite(longitude) &&
            latitude >= -90 && latitude <= 90 &&
            longitude >= -180 && longitude <= 180;
    }

    function normalizeStatus(value) {
        return String(value || '')
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '')
            .trim()
            .toLowerCase();
    }

    function canShowLiveRoute(order) {
        const status = normalizeStatus(order.status || order.estado || order.deliveryStatus);
        return status.includes('camino') || status.includes('entregad') || status.includes('finaliz');
    }

    function escapeHtml(value) {
        return String(value ?? '').replace(/[&<>'"]/g, character => ({
            '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;'
        })[character]);
    }

    function isDelivered(order) {
        const status = normalizeStatus(order.status || order.estado || order.deliveryStatus);
        return status.includes('entregad') || status.includes('finaliz');
    }

    function routeWaitingMessage(order) {
        const status = normalizeStatus(order.status);
        if (status.includes('produccion')) {
            return {
                title: 'Pedido en producción',
                text: 'La ruta se activara cuando el equipo marque el pedido como En camino.'
            };
        }
        if (status.includes('listo')) {
            return {
                title: 'Pedido listo para despacho',
                text: 'El mapa mostrara la ruta real apenas se confirme la salida del pedido.'
            };
        }
        if (status.includes('confirmado')) {
            return {
                title: 'Pedido confirmado',
                text: 'Todavía no hay ruta activa. Primero debe pasar a producción y luego a envío.'
            };
        }
        if (status.includes('pendiente')) {
            return {
                title: 'Pedido pendiente',
                text: 'Cuando el pedido avance, aqui veras el estado y la ruta de entrega.'
            };
        }
        return {
            title: 'Ruta aun no iniciada',
            text: 'El seguimiento en mapa aparece cuando el pedido sale a entrega.'
        };
    }

    function sanitizeLocation(location, fallback) {
        const source = location || {};
        const safeFallback = fallback || defaultOrigin;
        const lat = Number(source.lat ?? source.latitude);
        const lng = Number(source.lng ?? source.longitude);
        return {
            ...safeFallback,
            ...source,
            name: source.name || source.label || safeFallback.name || 'Destino',
            label: source.label || source.name || safeFallback.label || safeFallback.name || 'Destino',
            country: source.country || safeFallback.country || 'Costa Rica',
            city: source.city || safeFallback.city || '',
            lat: isValidCoordinate(lat, lng) ? lat : safeFallback.lat,
            lng: isValidCoordinate(lat, lng) ? lng : safeFallback.lng
        };
    }

    function showPage() {
        page.classList.remove('track-page--loading');
        page.classList.add('track-page--ready');
    }

    function createPinHtml(iconClass, extraClass = '', staticPulse = false) {
        return `
            <div class="track-pin-wrap ${extraClass} ${staticPulse ? 'track-pin-static' : 'track-pin-moving'}">
                <div class="track-pin-pulse"></div>
                <div class="track-pin-core">
                    <i class="fas ${iconClass}"></i>
                </div>
            </div>
        `;
    }

    function makeIcon(iconClass, extraClass = '', staticPulse = false) {
        if (!window.L) return null;

        return L.divIcon({
            className: 'track-marker-icon',
            html: createPinHtml(iconClass, extraClass, staticPulse),
            iconSize: [42, 42],
            iconAnchor: [21, 21],
            popupAnchor: [0, -18]
        });
    }

    function getIcons() {
        return {
            origin: makeIcon('fa-store', 'track-pin-origin', true),
            destination: makeIcon('fa-location-dot', 'track-pin-destination', true),
            courier: makeIcon('fa-motorcycle', 'track-pin-courier'),
            plane: makeIcon('fa-plane', 'track-pin-plane')
        };
    }

    function getOrders() {
        const own = BakeSmartStore.orders.byClient(userEmail);
        return own.length ? own : BakeSmartStore.orders.list();
    }

    function ensureMap() {
        if (!window.L) return null;
        if (map) return map;
        origin = sanitizeLocation(origin, defaultOrigin);

        map = L.map('deliveryMap', {
            zoomControl: true,
            worldCopyJump: true,
            preferCanvas: true
        }).setView([origin.lat, origin.lng], 10);

        L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
            subdomains: 'abcd',
            maxZoom: 19,
            attribution: '&copy; OpenStreetMap &copy; CARTO'
        }).addTo(map);

        return map;
    }

    function clearVisuals() {
        markers.forEach(m => m.remove());
        layers.forEach(l => l.remove());
        document.querySelectorAll('.track-map-notice').forEach(node => node.remove());
        markers = [];
        layers = [];

    }

    function currentPointForOrder(order) {
        const tracking = order.tracking || {};
        const currentLat = Number(tracking.currentLat);
        const currentLng = Number(tracking.currentLng);
        if (isValidCoordinate(currentLat, currentLng) && !(currentLat === 0 && currentLng === 0)) {
            return [currentLat, currentLng];
        }
        return null;
    }

    async function roadRoute(start, end) {
        const query = new URLSearchParams({ startLat: start[0], startLng: start[1], endLat: end[0], endLng: end[1] });
        const response = await fetch(`/api/geo/route?${query}`);
        if (!response.ok) return null;
        const route = await response.json();
        return Array.isArray(route.points) && route.points.length > 1 ? route : null;
    }

    function renderLiveStatus(order, hasLiveRoute) {
        const steps = order.tracking?.steps || ['Pendiente pago', 'Confirmado', 'En produccion', 'Listo', 'En camino', 'Entregado'];
        const currentStep = isDelivered(order)
            ? Math.max(steps.length - 1, 0)
            : Math.min(Math.max(Number(order.tracking?.currentStep || 0), 0), Math.max(steps.length - 1, 1));
        const progress = isDelivered(order) ? 100 : Math.max(8, Math.round((currentStep / Math.max(steps.length - 1, 1)) * 100));
        const live = hasLiveRoute && !isDelivered(order);
        document.getElementById('trackLiveIcon').className = `fas ${live ? 'fa-motorcycle' : isDelivered(order) ? 'fa-circle-check' : 'fa-box'}`;
        document.getElementById('trackLiveEyebrow').textContent = live ? 'Entrega en movimiento' : 'Actualización del pedido';
        document.getElementById('trackLiveTitle').textContent = live ? 'Tu pedido va en camino' : isDelivered(order) ? 'Pedido entregado' : order.status;
        document.getElementById('trackLiveDetail').textContent = live
            ? 'El mapa muestra la ruta vial y únicamente la última ubicación real reportada.'
            : isDelivered(order) ? 'La entrega llegó a su destino.' : 'La ruta se activará cuando el pedido salga para entrega.';
        document.getElementById('trackProgressValue').textContent = `${progress}%`;
        document.getElementById('trackProgressBar').style.width = `${progress}%`;
        page.classList.toggle('track-page--live', live);
    }

    function exactDestination(order) {
        const tracking = order.tracking || {};
        const lat = Number(tracking.destinationLat);
        const lng = Number(tracking.destinationLng);
        if (!isValidCoordinate(lat, lng) || (lat === 0 && lng === 0)) return null;
        return {
            name: order.address || 'Destino del pedido',
            label: order.address || 'Destino del pedido',
            country: tracking.destinationCountry || 'Costa Rica',
            city: '', lat, lng
        };
    }

    function renderTimeline(order, destination, hasLiveRoute) {
        const currentStep = isDelivered(order)
            ? Math.max((order.tracking?.steps || ['Pedido recibido', 'Confirmado', 'En producción', 'Listo', 'Entregado']).length - 1, 0)
            : (order.tracking?.currentStep || 0);
        const isInternational = destination.country !== 'Costa Rica';
        const extraLabel = isInternational ? 'Salida aerea internacional' : 'Ruta terrestre metropolitana';
        const steps = [...(order.tracking?.steps || ['Pedido recibido', 'Confirmado', 'En producción', 'Listo', 'Entregado'])];

        if (hasLiveRoute && !steps.includes(extraLabel)) {
            steps.splice(4, 0, extraLabel);
        }

        document.getElementById('trackingTimeline').innerHTML = steps.map((step, index) => {
            const normalizedCurrent = isDelivered(order)
                ? steps.length - 1
                : (hasLiveRoute && isInternational && currentStep >= 3 ? currentStep + 1 : currentStep);
            const isDeliveredStep = normalizeStatus(step).includes('entregad');
            const state = index < normalizedCurrent || (index === normalizedCurrent && isDeliveredStep)
                ? 'done'
                : index === normalizedCurrent ? 'current' : 'pending';
            const icon = state === 'done' ? 'fa-check' : state === 'current' ? 'fa-bolt' : 'fa-clock';
            const detail = state === 'done'
                ? 'Completado'
                : state === 'current'
                    ? (hasLiveRoute ? 'Estado activo' : 'En espera operativa')
                    : 'Pendiente';

            return `
                <div class="timeline-item timeline-${state}">
                    <div class="timeline-dot"><i class="fas ${icon}"></i></div>
                    <div class="timeline-content">
                        <div class="timeline-title">${escapeHtml(step)}</div>
                        <div class="text-muted">${detail}</div>
                    </div>
                </div>
            `;
        }).join('');
    }

    function renderTrackingSummary(order, destination, routeType) {
        document.getElementById('trackingSummary').innerHTML = `
            <div class="summary-row"><span>Origen</span><strong>${escapeHtml(origin.name)}</strong></div>
            <div class="summary-row"><span>Cliente</span><strong>${escapeHtml(order.customerName)}</strong></div>
            <div class="summary-row"><span>Dirección</span><strong>${escapeHtml(order.address)}</strong></div>
            <div class="summary-row"><span>Modalidad</span><strong>${escapeHtml(routeType)}</strong></div>
            <div class="summary-row"><span>Entrega</span><strong>${new Date(order.deliveryDate).toLocaleDateString('es-CR')}</strong></div>
            <div class="summary-row"><span>Productos</span><strong>${escapeHtml((order.items || []).map(i => `${i.quantity} x ${i.name}`).join(', ') || 'Sin detalle')}</strong></div>
            <div class="summary-row"><span>Pago</span><strong>${escapeHtml(order.paymentStatus)} (${escapeHtml(order.paymentMethod || 'Pendiente')})</strong></div>
        `;
    }

    function renderMapFallback(order, destination, routeType) {
        document.getElementById('deliveryMap').innerHTML = `
            <div class="track-fallback-map">
                <div class="track-fallback-node">
                    <span><i class="fas fa-store"></i></span>
                    <strong>${origin.name}</strong>
                    <small>${origin.city}, ${origin.country}</small>
                </div>
                <div class="track-fallback-route">
                    <i class="fas ${routeType.includes('aerea') ? 'fa-plane' : 'fa-motorcycle'}"></i>
                    <span>${order.status}</span>
                </div>
                <div class="track-fallback-node">
                    <span><i class="fas fa-location-dot"></i></span>
                    <strong>${destination.name}</strong>
                    <small>${destination.country}</small>
                </div>
            </div>
        `;
    }

    function renderWaitingMap(order, destination, routeType, mapInstance, icons) {
        const message = routeWaitingMessage(order);
        document.getElementById('trackMeta').textContent = `${message.title}. ${message.text}`;

        if (!mapInstance) {
            document.getElementById('deliveryMap').innerHTML = `
                <div class="track-empty-state">
                    <i class="fas fa-clock"></i>
                    <strong>${message.title}</strong>
                    <span>${message.text}</span>
                </div>
            `;
            return;
        }

        const startLatLng = [origin.lat, origin.lng];
        const originMarker = L.marker(startLatLng, { icon: icons.origin })
            .addTo(mapInstance)
            .bindPopup(`${origin.name}<br>${origin.lat.toFixed(4)}, ${origin.lng.toFixed(4)}`);
        markers.push(originMarker);
        mapInstance.setView(startLatLng, 13);

        const notice = document.createElement('div');
        notice.className = 'track-map-notice';
        notice.innerHTML = `
            <span><i class="fas fa-bell"></i></span>
            <div>
                <strong>${message.title}</strong>
                <p>${message.text}</p>
            </div>
        `;
        document.getElementById('deliveryMap').appendChild(notice);
        requestAnimationFrame(() => mapInstance.invalidateSize(true));
    }

    async function renderOrder(orderId) {
        const orders = getOrders();
        const order = orders.find(x => Number(x.id) === Number(orderId)) || orders[0];
        if (!order) return;

        activeOrderId = order.id;

        const destination = exactDestination(order);
        const safeDestination = destination || { name: order.address || 'Dirección pendiente', country: 'Costa Rica' };
        const isInternational = safeDestination.country !== 'Costa Rica';
        const hasLiveRoute = canShowLiveRoute(order);
        const routeType = hasLiveRoute ? (isInternational ? 'Trayectoria aerea' : 'Trayecto local') : 'Ruta pendiente';
        document.getElementById('trackOrderId').textContent = `#${order.id}`;
        document.getElementById('trackStatus').textContent = order.status;
        document.getElementById('trackRouteType').textContent = routeType;
        document.getElementById('trackMeta').textContent = `${origin.city}, ${origin.country} → ${safeDestination.name}, ${safeDestination.country}`;

        clearVisuals();
        renderTimeline(order, safeDestination, hasLiveRoute);
        renderTrackingSummary(order, safeDestination, routeType);
        renderLiveStatus(order, hasLiveRoute);

        const mapInstance = ensureMap();
        const startLatLng = [origin.lat, origin.lng];
        if (!destination) {
            document.getElementById('trackMeta').textContent = 'Este pedido no tiene coordenadas verificadas. La dirección debe corregirse antes de mostrar una ruta.';
            document.getElementById('deliveryMap').innerHTML = '<div class="track-empty-state"><i class="fas fa-map-location-dot"></i><strong>Ubicación exacta pendiente</strong><span>No mostraremos pines aproximados ni ubicaciones inventadas. Actualice la dirección del pedido para habilitar el mapa.</span></div>';
            return;
        }
        const destinationLatLng = [destination.lat, destination.lng];
        if (!mapInstance || !isValidCoordinate(startLatLng[0], startLatLng[1])) return;

        const icons = getIcons();

        const originMarker = L.marker(startLatLng, { icon: icons.origin }).addTo(mapInstance).bindPopup(`${origin.name}<br>${origin.lat.toFixed(4)}, ${origin.lng.toFixed(4)}`);
        const destinationMarker = L.marker(destinationLatLng, { icon: icons.destination }).addTo(mapInstance).bindPopup(`${destination.name}<br>${destination.lat.toFixed(4)}, ${destination.lng.toFixed(4)}`);
        markers.push(originMarker, destinationMarker);
        const calculatedRoute = await roadRoute(startLatLng, destinationLatLng);
        if (Number(activeOrderId) !== Number(order.id)) return;
        const routePoints = calculatedRoute?.points || [startLatLng, destinationLatLng];
        const route = L.polyline(routePoints, { color: '#7c3aed', weight: 5, opacity: .88, dashArray: calculatedRoute ? null : '8 10' }).addTo(mapInstance);
        layers.push(route);
        const currentPoint = currentPointForOrder(order);
        if (hasLiveRoute && currentPoint) {
            const courierMarker = L.marker(currentPoint, { icon: icons.courier }).addTo(mapInstance).bindPopup('Última ubicación real reportada');
            markers.push(courierMarker);
        }
        const distance = calculatedRoute ? `${(calculatedRoute.distanceMeters / 1000).toFixed(1)} km` : 'distancia no disponible';
        document.getElementById('trackMeta').textContent = `${calculatedRoute ? 'Ruta vial calculada' : 'Conexión directa de referencia'} · ${distance} · ${currentPoint ? 'ubicación real reportada' : 'sin ubicación en vivo'}`;
        mapInstance.fitBounds(L.latLngBounds(routePoints), { padding: [48, 48] });

        requestAnimationFrame(() => {
            mapInstance.invalidateSize(true);
        });

        renderTimeline(order, destination, hasLiveRoute);
        renderTrackingSummary(order, destination, routeType);
    }

    function renderSelector() {
        const orders = getOrders();

        if (!orders.length) {
            orderSelect.innerHTML = '<option>Sin pedidos</option>';
            orderSelect.disabled = true;
            document.getElementById('trackOrderId').textContent = '-';
            document.getElementById('trackStatus').textContent = 'Sin actividad';
            document.getElementById('trackRouteType').textContent = '-';
            document.getElementById('trackMeta').textContent = 'Todavía no hay pedidos para mostrar.';
            document.getElementById('deliveryMap').innerHTML = `
                <div class="track-empty-state">
                    <i class="fas fa-box-open"></i>
                    <strong>No tienes pedidos en seguimiento</strong>
                    <span>Cuando registres un pedido, aqui veras su ruta y progreso.</span>
                </div>
            `;
            document.getElementById('trackingTimeline').innerHTML = `
                <div class="track-empty-state track-empty-state--compact">
                    <i class="fas fa-route"></i>
                    <strong>Sin recorrido activo</strong>
                    <span>El seguimiento se activa despues de crear un pedido.</span>
                </div>
            `;
            document.getElementById('trackingSummary').innerHTML = `
                <div class="summary-row"><span>Estado</span><strong>Sin pedidos registrados</strong></div>
            `;
            return;
        }

        orderSelect.innerHTML = orders.map(o =>
            `<option value="${Number(o.id)}">#${Number(o.id)} - ${escapeHtml(o.customerName)} - ${escapeHtml(o.status)}</option>`
        ).join('');

        renderOrder(orders[0]?.id);
    }

    orderSelect.addEventListener('change', () => renderOrder(orderSelect.value));

    async function initializePage() {
        if (pageInitialized) return;
        pageInitialized = true;

        try {
            await BakeSmartStore.refresh({ keys: ['orders', 'posConfig'] });
            origin = sanitizeLocation(BakeSmartStore.geo.origin(), defaultOrigin);
            renderSelector();
        } finally {
            requestAnimationFrame(() => {
                showPage();
                if (map) {
                    map.invalidateSize(true);
                }
            });
        }
    }

    app.page.ready(initializePage);
})();
</script>
}

