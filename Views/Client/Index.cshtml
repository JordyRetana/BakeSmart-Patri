@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <link rel="stylesheet" href="~/css/pages/client-index.css?v=20260718-visual-quick-order" />
}
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Mi panel";
    var nameLabel = User?.Identity?.Name ?? "Cliente";
    var emailLabel = User?.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "";
    var sinpeBusinessNumber = Context.RequestServices.GetRequiredService<Microsoft.Extensions.Configuration.IConfiguration>()["Business:SinpeNumber"] ?? "+506 8888 8888";
}

<div class="page-shell client-dashboard-page client-dashboard-page--loading" id="clientDashboardPage">
    <section class="client-hero">
        <div class="client-hero__copy">
            <span class="client-hero__eyebrow">Panel de cliente</span>
            <h1>Hola, @nameLabel</h1>
            <p>Revisa tus pedidos, crea una solicitud rapida con productos disponibles y mantente al tanto de cada entrega.</p>
        </div>

        <div class="client-hero__actions" aria-label="Accesos principales">
            <a href="/Client/Orders" class="client-action">
                <span class="client-action__icon"><i class="fas fa-box-open"></i></span>
                <span>
                    <strong>Mis pedidos</strong>
                    <small>Historial y pagos</small>
                </span>
            </a>
            <a href="/Client/Track" class="client-action">
                <span class="client-action__icon"><i class="fas fa-route"></i></span>
                <span>
                    <strong>Seguimiento</strong>
                    <small>Estado y ubicacion</small>
                </span>
            </a>
            <a href="/Client/Profile" class="client-action">
                <span class="client-action__icon"><i class="fas fa-user-pen"></i></span>
                <span>
                    <strong>Perfil</strong>
                    <small>Datos y dirección</small>
                </span>
            </a>
        </div>
    </section>

    <section class="client-metrics" aria-label="Resumen de pedidos">
        <article class="client-metric">
            <span class="client-metric__icon"><i class="fas fa-receipt"></i></span>
            <span class="client-metric__label">Pedidos realizados</span>
            <strong id="clientOrderCount">0</strong>
        </article>
        <article class="client-metric">
            <span class="client-metric__icon"><i class="fas fa-wallet"></i></span>
            <span class="client-metric__label">Total comprado</span>
            <strong id="clientSpent">0</strong>
        </article>
        <article class="client-metric">
            <span class="client-metric__icon"><i class="fas fa-clock"></i></span>
            <span class="client-metric__label">Pedidos activos</span>
            <strong id="clientActive">0</strong>
        </article>
        <article class="client-metric">
            <span class="client-metric__icon"><i class="fas fa-cake-candles"></i></span>
            <span class="client-metric__label">Productos disponibles</span>
            <strong id="clientAvailableProducts">0</strong>
        </article>
    </section>

    <section class="client-workspace">
        <article class="client-panel client-panel--order">
            <div class="client-panel__header">
                <div>
                    <span class="client-panel__eyebrow">Pedido rapido</span>
                    <h2>Elige un producto disponible</h2>
                </div>
                <a class="client-panel__link" href="/Catalog">
                    <i class="fas fa-store"></i>
                    Catálogo
                </a>
            </div>

            <form id="quickOrderForm" class="quick-order">
                <div class="quick-order__catalog">
                    <div class="quick-order__toolbar">
                        <label class="quick-search">
                            <i class="fas fa-search"></i>
                            <input type="search" id="quickProductSearch" placeholder="Buscar producto disponible" autocomplete="off" />
                        </label>
                        <select id="quickProductSort" class="quick-sort" aria-label="Ordenar productos">
                            <option value="all">Todos los productos</option>
                            <option value="priceAsc">Menor precio</option>
                            <option value="priceDesc">Mayor precio</option>
                            <option value="stockDesc">Mas stock</option>
                        </select>
                    </div>

                    <input type="hidden" name="productId" id="quickOrderProduct" required />
                    <div class="quick-products" id="quickProducts"></div>
                    <p class="quick-products-empty" id="quickProductsEmpty" hidden>No hay productos disponibles con ese filtro.</p>
                </div>

                <div class="quick-order__details">
                    <input type="hidden" name="customerName" id="quickCustomerName" value="@nameLabel" />
                    <input type="hidden" name="customerEmail" id="quickCustomerEmail" value="@emailLabel" />
                    <input type="hidden" name="customerPhone" id="quickCustomerPhone" />

                    <div class="quick-order__section">
                        <h3><i class="fas fa-user-check"></i> Datos del perfil</h3>
                        <div class="profile-source">
                            <span class="profile-source__icon"><i class="fas fa-id-card"></i></span>
                            <span>
                                <strong id="quickProfileName">@nameLabel</strong>
                                <small id="quickProfileMeta">@emailLabel</small>
                            </span>
                            <a href="/Client/Profile">Editar</a>
                        </div>
                    </div>

                    <div class="quick-order__section">
                        <h3><i class="fas fa-calendar-day"></i> Fecha y cantidad</h3>
                        <div class="quick-form-grid quick-form-grid--compact">
                            <label>
                                <span>Fecha de entrega</span>
                                <input class="form-control" name="deliveryDate" type="date" required />
                            </label>
                            <label>
                                <span>Cantidad</span>
                                <input class="form-control" name="quantity" id="quickQuantity" type="number" min="1" value="1" required />
                            </label>
                        </div>
                    </div>

                    <div class="quick-order__section">
                        <h3><i class="fas fa-truck"></i> Entrega y pago</h3>
                        <div class="quick-form-grid quick-form-grid--compact">
                            <label>
                                <span>Entrega</span>
                                <select class="form-control" name="deliveryMethod" id="quickDeliveryMethod">
                                    <option value="domicilio">A domicilio</option>
                                    <option value="retiro">Retiro en tienda</option>
                                </select>
                            </label>
                            <label>
                                <span>Pago</span>
                                <select class="form-control" name="paymentMethod" id="quickPaymentMethod">
                                    <option value="Pago en linea">Pagar ahora</option>
                                    <option value="Pendiente">Pagar en tienda</option>
                                    <option value="SINPE">SINPE</option>
                                    <option value="Tarjeta">Tarjeta</option>
                                    <option value="PayPal">PayPal</option>
                                </select>
                            </label>
                        </div>
                    </div>

                    <div id="quickDeliveryProfileBlock" class="quick-order__section">
                        <h3><i class="fas fa-location-dot"></i> Direccion del perfil</h3>
                        <div class="profile-source">
                            <span class="profile-source__icon"><i class="fas fa-map-location-dot"></i></span>
                            <span>
                                <strong id="quickProfileAddress">Sin dirección configurada</strong>
                                <small>La dirección se administra desde Perfil</small>
                            </span>
                            <a href="/Client/Profile">Configurar</a>
                        </div>
                        <input type="hidden" name="address" id="quickAddress" />
                        <input type="hidden" name="destinationLatitude" id="quickLat" />
                        <input type="hidden" name="destinationLongitude" id="quickLng" />
                        <input type="hidden" name="customerAddressId" id="quickCustomerAddressId" />
                    </div>

                    <div class="quick-order__section">
                        <h3><i class="fas fa-note-sticky"></i> Notas</h3>
                        <textarea class="form-control" name="notes" rows="3" placeholder="Decoracion, horario, dedicatoria o detalles especiales"></textarea>
                    </div>
                </div>

                <aside class="quick-summary" aria-label="Resumen del pedido">
                    <div>
                        <span class="quick-summary__label">Producto seleccionado</span>
                        <strong id="quickSummaryProduct">Seleccione un producto</strong>
                    </div>
                    <div class="quick-summary__rows">
                        <div><span>Subtotal</span><strong id="quickSubtotal">0</strong></div>
                        <div id="quickDiscountRow" hidden><span>Descuento aplicado</span><strong id="quickDiscount">0</strong></div>
                        <div><span>IVA</span><strong id="quickTax">0</strong></div>
                        <div class="quick-summary__total"><span>Total</span><strong id="quickTotal">0</strong></div>
                    </div>
                    <button class="btn btn-primary quick-submit" type="submit" id="quickOrderSubmitBtn">
                        <i class="fas fa-credit-card"></i>
                        Registrar y continuar
                    </button>
                </aside>
            </form>
        </article>

        <aside class="client-panel client-panel--orders">
            <div class="client-panel__header">
                <div>
                    <span class="client-panel__eyebrow">Actividad</span>
                    <h2>Últimos pedidos</h2>
                </div>
                <a class="client-panel__link" href="/Client/Orders">
                    <i class="fas fa-arrow-right"></i>
                    Ver todos
                </a>
            </div>
            <div class="client-orders-list" id="clientMiniOrders"></div>
        </aside>
    </section>
</div>

<div class="payment-modal quick-address-modal" id="quickAddressModal" hidden>
    <div class="payment-modal__backdrop" data-address-close></div>
    <section class="payment-modal__dialog quick-address-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="quickAddressModalTitle">
        <button class="payment-modal__close" type="button" data-address-close aria-label="Cerrar">
            <i class="fas fa-xmark"></i>
        </button>
        <div class="payment-modal__header">
            <span class="payment-modal__icon"><i class="fas fa-map-location-dot"></i></span>
            <div>
                <span class="client-panel__eyebrow">Entrega a domicilio</span>
                <h2 id="quickAddressModalTitle">Elige la dirección de entrega</h2>
            </div>
        </div>
        <div class="quick-address-choice" id="quickSavedAddressChoice" hidden>
            <div>
                <span>Direccion guardada</span>
                <strong id="quickSavedAddressText">Sin dirección</strong>
            </div>
            <button class="btn btn-outline" type="button" id="useSavedAddressBtn">
                <i class="fas fa-check"></i>
                Usar esta
            </button>
        </div>
        <div class="quick-address-picker">
            <label>
                <span>Direccion nueva</span>
                <input class="form-control" id="quickAddressManual" placeholder="Ej. Escazu, San Jose, cerca del parque" autocomplete="street-address" />
            </label>
            <div id="quickMapPicker" class="quick-address-map"></div>
        </div>
        <div class="quick-address-modal__actions">
            <button class="btn btn-outline" type="button" data-address-close>Cancelar</button>
            <button class="btn btn-primary" type="button" id="useNewAddressBtn">
                <i class="fas fa-location-dot"></i>
                Usar dirección nueva
            </button>
        </div>
    </section>
</div>

<div class="payment-modal" id="clientPaymentModal" hidden>
    <div class="payment-modal__backdrop" data-payment-close></div>
    <section class="payment-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="paymentModalTitle">
        <button class="payment-modal__close" type="button" data-payment-close aria-label="Cerrar">
            <i class="fas fa-xmark"></i>
        </button>
        <div class="payment-modal__header">
            <span class="payment-modal__icon"><i class="fas fa-shield-halved"></i></span>
            <div>
                <span class="client-panel__eyebrow">Pasarela de pago</span>
                <h2 id="paymentModalTitle">Confirmar pago</h2>
            </div>
        </div>
        <div class="payment-modal__amount">
            <span>Total a pagar</span>
            <strong id="paymentModalTotal">0</strong>
        </div>
        <form id="clientPaymentForm" class="payment-form" novalidate>
            <label>
                <span>Método de pago</span>
                <select class="form-control" name="method" id="paymentGatewayMethod">
                    <option value="Tarjeta">Tarjeta segura con Stripe</option>
                    <option value="PayPal">PayPal</option>
                    <option>SINPE</option>
                    <option>Efectivo</option>
                </select>
            </label>
            <div class="payment-modal__sinpe" id="paymentSinpeInstructions" hidden>
                <span>Realiza el SINPE Móvil al número de la empresa</span>
                <strong>@sinpeBusinessNumber</strong>
                <small>El pedido queda pendiente hasta que el negocio confirme la transferencia.</small>
            </div>
            <p class="payment-modal__note" id="paymentGatewayNote">Serás redirigido a Stripe para pagar de forma segura.</p>
            <button class="btn btn-primary quick-submit" type="button" id="paymentConfirmBtn">
                <i class="fas fa-lock"></i>
                <span id="paymentConfirmText">Pagar pedido</span>
            </button>
        </form>
    </section>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="~/js/bakesmart-map-picker.js" asp-append-version="true"></script>
    <script>
        (() => {
        const page = document.getElementById('clientDashboardPage');
        const userEmail = document.body.dataset.userEmail || '';
        const form = document.getElementById('quickOrderForm');
        const productInput = document.getElementById('quickOrderProduct');
        const productsGrid = document.getElementById('quickProducts');
        const productsEmpty = document.getElementById('quickProductsEmpty');
        const productSearch = document.getElementById('quickProductSearch');
        const productSort = document.getElementById('quickProductSort');
        const quantityInput = document.getElementById('quickQuantity');
        const submitBtn = document.getElementById('quickOrderSubmitBtn');
        const deliveryMethod = document.getElementById('quickDeliveryMethod');
        const deliveryProfileBlock = document.getElementById('quickDeliveryProfileBlock');
        const paymentModal = document.getElementById('clientPaymentModal');
        const paymentForm = document.getElementById('clientPaymentForm');
        const paymentMethod = document.getElementById('paymentGatewayMethod');
        const paymentConfirmBtn = document.getElementById('paymentConfirmBtn');
        const paymentConfirmText = document.getElementById('paymentConfirmText');
        const paymentReferenceLabel = document.getElementById('paymentReferenceLabel');
        const paymentReferenceInput = document.getElementById('paymentReferenceInput');
        const addressModal = document.getElementById('quickAddressModal');
        const savedAddressChoice = document.getElementById('quickSavedAddressChoice');
        const savedAddressText = document.getElementById('quickSavedAddressText');
        const manualAddressInput = document.getElementById('quickAddressManual');
        const useSavedAddressBtn = document.getElementById('useSavedAddressBtn');
        const useNewAddressBtn = document.getElementById('useNewAddressBtn');

        let pageInitialized = false;
        let products = [];
        let selectedProduct = null;
        const selectedProducts = new Map();
        let currentProfile = null;
        let pendingPayment = null;
        let addressPicker = null;
        let submitAfterAddress = false;
        let cartCheckoutItems = [];

        const cartStorageKeyFor = identity => `bakesmart:catalog-cart:${(identity || 'guest').trim().toLowerCase()}`;
        const cartStorageKey = () => cartStorageKeyFor(userEmail || 'guest');

        function normalizeCartItems(rawItems) {
        return (Array.isArray(rawItems) ? rawItems : [])
        .map(item => item?.isCombo && Number(item.comboId) > 0
        ? { id: `combo-${Number(item.comboId)}`, comboId: Number(item.comboId), isCombo: true, name: String(item.name || 'Combo'), price: Number(item.price || 0), quantity: Math.max(1, Number(item.quantity || 1)), items: Array.isArray(item.items) ? item.items : [] }
        : { id: Number(item.id), name: String(item.name || 'Producto'), price: Number(item.price || 0), quantity: Math.max(1, Number(item.quantity || 1)) })
        .filter(item => (item.isCombo || item.id > 0) && item.quantity > 0);
        }

        function readCatalogCart() {
        try {
        const userKey = cartStorageKey();
        const guestKey = cartStorageKeyFor('guest');
        const itemsById = new Map();
        [guestKey, userKey].forEach(key => {
        normalizeCartItems(JSON.parse(localStorage.getItem(key) || '[]')).forEach(item => {
        const itemKey = item.isCombo ? `combo-${item.comboId}` : `product-${item.id}`;
        const existing = itemsById.get(itemKey);
        itemsById.set(itemKey, existing ? { ...item, quantity: existing.quantity + item.quantity } : item);
        });
        });
        const items = [...itemsById.values()];
        if (userEmail && guestKey !== userKey && items.length) {
        localStorage.setItem(userKey, JSON.stringify(items));
        localStorage.removeItem(guestKey);
        }
        return items;
        } catch {
        return [];
        }
        }

        function clearCatalogCart() {
        try {
        localStorage.removeItem(cartStorageKey());
        localStorage.removeItem(cartStorageKeyFor('guest'));
        } catch { }
        }

        const money = value => app.utils.formatCurrency(Number(value || 0));
        const clean = value => String(value ?? '').replace(/[&<>"']/g, char => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#039;'
        })[char]);

        function showPage() {
        page.classList.remove('client-dashboard-page--loading');
        page.classList.add('client-dashboard-page--ready');
        }

        function normalizeProduct(product) {
        return {
        ...product,
        id: Number(product.id),
        name: product.description || product.item || product.name || 'Producto',
        code: product.code || product.sku || '',
        price: Number(product.price || 0),
        stock: Number(product.stock || 0),
        active: product.active !== false,
        type: product.type || product.productType || ''
        };
        }

        function isSellableProduct(product) {
        return String(product.type || '').toLowerCase() === 'producto terminado';
        }

        function availableProducts() {
        const query = productSearch.value.trim().toLowerCase();
        let rows = products.filter(product =>
        product.active &&
        isSellableProduct(product) &&
        (!query ||
        product.name.toLowerCase().includes(query) ||
        product.code.toLowerCase().includes(query))
        );

        rows = rows.sort((a, b) => {
        if (productSort.value === 'priceAsc') return a.price - b.price;
        if (productSort.value === 'priceDesc') return b.price - a.price;
        if (productSort.value === 'stockDesc') return b.stock - a.stock;
        return b.stock - a.stock || a.name.localeCompare(b.name);
        });

        return rows;
        }

        function selectProduct(id, mode = 'toggle') {
        const product = products.find(item => Number(item.id) === Number(id)) || null;
        if (!product) return;

        if (mode === 'toggle' && selectedProducts.has(Number(product.id))) {
        selectedProducts.delete(Number(product.id));
        selectedProduct = [...selectedProducts.values()].at(-1)?.product || null;
        } else {
        const existing = selectedProducts.get(Number(product.id));
        selectedProducts.set(Number(product.id), { product, quantity: existing?.quantity || 1 });
        selectedProduct = product;
        }

        function expandCatalogCartForOrder(rawItems) {
        return rawItems.flatMap(item => {
        if (!item.isCombo) return [{ ...item, product: products.find(row => Number(row.id) === Number(item.id)) }];
        const components = (item.items || []).map(component => ({
        product: products.find(row => Number(row.id) === Number(component.productId)),
        quantity: Math.max(1, Number(component.quantity || 1)) * Math.max(1, Number(item.quantity || 1))
        })).filter(component => component.product);
        const regularTotal = components.reduce((sum, component) => sum + Number(component.product.price || 0) * component.quantity, 0);
        return components.map(component => ({
        product: component.product,
        quantity: component.quantity,
        unitPrice: regularTotal > 0
        ? (Number(item.price || 0) * (Number(component.product.price || 0) * component.quantity / regularTotal)) / component.quantity
        : Number(item.price || 0) / Math.max(1, components.reduce((sum, row) => sum + row.quantity, 0)),
        comboName: item.name
        }));
        });
        }

        productInput.value = [...selectedProducts.keys()].join(',');
        quantityInput.value = selectedProduct ? (selectedProducts.get(Number(selectedProduct.id))?.quantity || 1) : 1;
        renderProducts();
        updateSummary();
        }

        function renderProducts() {
        const rows = availableProducts();
        productsEmpty.hidden = rows.length > 0;

        productsGrid.innerHTML = rows.map(product => {
        const selected = selectedProducts.has(Number(product.id));
        const imageUrl = product.imageUrl || '/img/products/producto-sin-imagen.svg';
        return `
        <button class="quick-product ${selected ? 'quick-product--selected' : ''}" type="button" data-product-id="${product.id}">
        <span class="quick-product__image"><img src="${clean(imageUrl)}" alt="${clean(product.name)}" onerror="this.src='/img/products/producto-sin-imagen.svg';" /></span>
        <span class="quick-product__body">
        <strong>${clean(product.name)}</strong>
        <small>${clean(product.code || 'Producto disponible')}</small>
        </span>
        <span class="quick-product__meta">
        <strong>${money(product.price)}</strong>
        <small>${product.stock > 0 ? `${product.stock} disp.` : 'Por encargo'}</small>
        </span>
        </button>
        `;
        }).join('');
        }

        function fillPaymentMethods() {
        const methods = (BakeSmartStore.pos.config().paymentMethods || []).filter(method => method.active);
        const names = new Set(['Pago en linea', 'Pendiente', 'Tarjeta', 'PayPal', 'SINPE']);
        methods.forEach(method => names.add(method.name));

        document.getElementById('quickPaymentMethod').innerHTML = [...names]
        .map(name => `<option value="${clean(name)}">${clean(name === 'Pago en linea' ? 'Pagar ahora' : name === 'Pendiente' ? 'Pagar en tienda' : name)}</option>`)
        .join('');
        }

        async function loadProducts() {
        await BakeSmartStore.refreshClient();
        products = BakeSmartStore.inventory.list().map(normalizeProduct);
        document.getElementById('clientAvailableProducts').textContent =
        products.filter(product => product.active && isSellableProduct(product)).length;

        fillPaymentMethods();
        renderProducts();

        const first = availableProducts()[0];
        if (first) selectProduct(first.id, 'replace');
        applyCatalogCartCheckout();
        }

        async function loadProfile() {
        try {
        currentProfile = await BakeSmartStore.loadProfile();
        } catch (_) {
        currentProfile = null;
        }

        const fullName = currentProfile
        ? `${currentProfile.firstName || ''} ${currentProfile.lastName || ''}`.trim()
        : '@nameLabel';
        const email = currentProfile?.email || userEmail || '@emailLabel';
        const phone = currentProfile?.phone || '';

        document.getElementById('quickCustomerName').value = fullName || 'Cliente';
        document.getElementById('quickCustomerEmail').value = email;
        document.getElementById('quickCustomerPhone').value = phone;
        document.getElementById('quickProfileName').textContent = fullName || 'Cliente';
        document.getElementById('quickProfileMeta').textContent = phone ? `${email} - ${phone}` : email;

        document.getElementById('quickProfileAddress').textContent = currentProfile?.address || 'Sin dirección configurada';
        document.getElementById('quickAddress').value = currentProfile?.address || '';
        document.getElementById('quickLat').value = currentProfile?.latitude ?? '';
        document.getElementById('quickLng').value = currentProfile?.longitude ?? '';
        document.getElementById('quickCustomerAddressId').value = currentProfile?.customerAddressId ?? '';
        }

        function hasSavedAddress() {
        return Boolean(currentProfile?.address && currentProfile?.latitude && currentProfile?.longitude);
        }

        function applySavedAddress() {
        if (!hasSavedAddress()) return false;
        document.getElementById('quickAddress').value = currentProfile.address || '';
        document.getElementById('quickLat').value = currentProfile.latitude ?? '';
        document.getElementById('quickLng').value = currentProfile.longitude ?? '';
        document.getElementById('quickCustomerAddressId').value = currentProfile.customerAddressId ?? '';
        document.getElementById('quickProfileAddress').textContent = currentProfile.address || 'Direccion guardada';
        return true;
        }

        async function ensureAddressPicker() {
        if (addressPicker) return addressPicker;
        for (let i = 0; i < 20 && (!window.L || !window.BakeSmartMapPicker); i++) {
        await new Promise(resolve => setTimeout(resolve, 150));
        }
        if (!window.L || !window.BakeSmartMapPicker) {
        document.getElementById('quickMapPicker').innerHTML = `
        <div class="client-empty-state quick-map-fallback">
        <i class="fas fa-map-location-dot"></i>
        <strong>Mapa no disponible</strong>
        <span>Escriba la dirección y vuelva a intentarlo en unos segundos.</span>
        </div>
        `;
        return null;
        }
        const origin = BakeSmartStore.geo.origin();
        addressPicker = await BakeSmartMapPicker.create('quickMapPicker', {
        lat: currentProfile?.latitude || origin.lat,
        lng: currentProfile?.longitude || origin.lng,
        address: currentProfile?.address || '',
        onChange: values => {
        manualAddressInput.value = values.address || manualAddressInput.value || '';
        }
        });
        return addressPicker;
        }

        async function openAddressModal(continueAfterSelection = false) {
        submitAfterAddress = continueAfterSelection;
        savedAddressChoice.hidden = !hasSavedAddress();
        savedAddressText.textContent = currentProfile?.address || 'Sin dirección guardada';
        manualAddressInput.value = currentProfile?.address || '';
        addressModal.hidden = false;
        await ensureAddressPicker();
        if (addressPicker) {
        addressPicker.setValues({
        address: currentProfile?.address || '',
        lat: currentProfile?.latitude || BakeSmartStore.geo.origin().lat,
        lng: currentProfile?.longitude || BakeSmartStore.geo.origin().lng
        });
        requestAnimationFrame(() => addressPicker.map?.invalidateSize?.());
        setTimeout(() => addressPicker.map?.invalidateSize?.(), 250);
        setTimeout(() => addressPicker.map?.invalidateSize?.(), 900);
        }
        }

        function closeAddressModal() {
        addressModal.hidden = true;
        submitAfterAddress = false;
        }

        function continuePendingSubmit() {
        const shouldContinue = submitAfterAddress;
        closeAddressModal();
        if (shouldContinue) {
        requestAnimationFrame(() => form.requestSubmit());
        }
        }


        function applyCatalogCartCheckout() {
        const parameters = new URLSearchParams(window.location.search);
        if (parameters.get('cart') !== 'checkout') return;

        const availableIds = new Set(availableProducts().map(product => Number(product.id)));
        cartCheckoutItems = expandCatalogCartForOrder(readCatalogCart())
        .filter(item => item.product && availableIds.has(Number(item.product.id)))
        .map(item => {
        const product = item.product;
        return {
        ...item,
        product,
        quantity: Math.min(Number(item.quantity || 1), Number(product?.stock || 0))
        };
        })
        .filter(item => item.product && item.quantity > 0);

        if (!cartCheckoutItems.length) return;

        const first = cartCheckoutItems[0];
        selectedProducts.clear();
        selectProduct(first.id, 'replace');
        quantityInput.value = first.quantity;
        updateSummary();
        submitBtn.innerHTML = `<i class="fas fa-receipt"></i> Registrar ${cartCheckoutItems.length} producto${cartCheckoutItems.length === 1 ? '' : 's'} del carrito`;
        app.toast.success('Carrito cargado. Completa entrega y pago para crear un pedido nuevo.');
        }

        function renderSummary() {
        const orders = BakeSmartStore.orders.byClient(userEmail);
        const total = orders.reduce((acc, order) => acc + Number(order.total || 0), 0);
        const active = orders.filter(order => !['Entregado', 'Cancelado'].includes(order.status)).length;

        document.getElementById('clientOrderCount').textContent = orders.length;
        document.getElementById('clientSpent').textContent = money(total);
        document.getElementById('clientActive').textContent = active;

        const recent = orders.slice(0, 5);
        document.getElementById('clientMiniOrders').innerHTML = recent.map(order => `
        <article class="client-order-row">
        <span class="client-order-row__icon"><i class="fas fa-bag-shopping"></i></span>
        <span class="client-order-row__main">
        <strong>#${order.id} · ${clean((order.items || []).map(item => item.name).join(', ') || 'Pedido')}</strong>
        <small>${clean(order.deliveryDate || order.createdAt || '')}</small>
        </span>
        <span class="client-order-row__status">
        <span class="badge badge-primary">${clean(order.status || 'Pendiente')}</span>
        <strong>${money(order.total)}</strong>
        </span>
        </article>
        `).join('') || `
        <div class="client-empty-state">
        <i class="fas fa-clipboard-list"></i>
        <strong>Aun no tienes pedidos</strong>
        <span>Cuando registres uno, aparecera aqui.</span>
        </div>
        `;
        decorateMiniOrders(orders);
        }

        function decorateMiniOrders(orders) {
        const rows = document.querySelectorAll('.client-order-row');
        rows.forEach((row, index) => {
        const order = orders[index];
        if (!order || !String(order.paymentStatus || '').toLowerCase().includes('pendiente')) return;
        row.classList.add('client-order-row--payable');
        if (row.querySelector('[data-pay-deposit]')) return;
        const target = row.querySelector('.client-order-row__status');
        if (!target) return;
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'btn btn-outline btn-sm client-deposit-btn';
        button.dataset.payDeposit = order.id;
        button.innerHTML = '<i class="fas fa-money-bill-transfer"></i> Pagar abono';
        target.appendChild(button);
        });
        }

        function updateSummary() {
        const orderItems = cartCheckoutItems.length
        ? cartCheckoutItems.map(item => ({ product: item.product, quantity: item.quantity, unitPrice: item.price }))
        : [...selectedProducts.values()];
        const subtotal = orderItems.reduce((sum, item) => sum + Number(item.unitPrice || item.product?.price || 0) * Math.max(1, Number(item.quantity || 1)), 0);
        const taxRate = Number(BakeSmartStore.pos.config().iva || 0);
        const frequentRate = currentProfile?.isFrequent ? Number(BakeSmartStore.pos.config().frequentCustomerDiscount || 0) : 0;
        const promotionRate = Number(BakeSmartStore.pos.config().activePromotionDiscount || 0);
        const discountRate = Math.max(frequentRate, promotionRate);
        const discount = subtotal * discountRate;
        const discountedSubtotal = Math.max(0, subtotal - discount);
        const tax = discountedSubtotal * taxRate;

        document.getElementById('quickSummaryProduct').textContent = orderItems.length === 1
        ? orderItems[0].product?.name || 'Seleccione un producto'
        : orderItems.length > 1 ? `${orderItems.length} productos seleccionados` : 'Seleccione uno o más productos';
        document.getElementById('quickSubtotal').textContent = money(subtotal);
        document.getElementById('quickDiscountRow').hidden = discount <= 0;
        document.getElementById('quickDiscount').textContent = `-${money(discount)}`;
        document.getElementById('quickTax').textContent = money(tax);
        document.getElementById('quickTotal').textContent = money(discountedSubtotal + tax);
        }

        function normalizeGatewayMethod(method) {
        const value = String(method || '').toLowerCase();
        if (value.includes('sinpe')) return 'SINPE';
        if (value.includes('efectivo')) return 'Efectivo';
        if (value.includes('paypal')) return 'PayPal';
        return 'Tarjeta';
        }

        function shouldOpenGateway(method) {
        const value = String(method || '').toLowerCase();
        return value.includes('linea') || value.includes('tarjeta') || value.includes('sinpe');
        }

        function openPaymentGateway(orderId, total, method, mode = 'full', orderIds = [orderId]) {
        const amount = mode === 'deposit' ? Math.max(1, Number(total || 0) * 0.3) : Number(total || 0);
        pendingPayment = { orderId, orderIds, total: amount, method, mode };
        if (paymentModal.parentElement !== document.body) {
        document.body.appendChild(paymentModal);
        }
        document.getElementById('paymentModalTotal').textContent = money(amount);
        paymentMethod.value = normalizeGatewayMethod(method);
        paymentConfirmText.textContent = mode === 'deposit' ? 'Pagar abono' : 'Pagar pedido';
        paymentMethod.dispatchEvent(new Event('change', { bubbles: true }));
        syncPaymentFields();
        paymentModal.hidden = false;
        }

        function closePaymentGateway() {
        paymentModal.hidden = true;
        pendingPayment = null;
        paymentForm.reset();
        paymentConfirmText.textContent = 'Pagar pedido';
        syncPaymentFields();
        }

        function syncPaymentFields() {
        const value = String(paymentMethod.value || '').toLowerCase();
        const sinpe = value.includes('sinpe');
        document.getElementById('paymentSinpeInstructions').hidden = !sinpe;
        document.getElementById('paymentGatewayNote').textContent = value.includes('paypal')
        ? 'Serás redirigido a PayPal para autorizar y validar el pago.'
        : sinpe
        ? 'Confirma únicamente después de hacer la transferencia.'
        : value.includes('efectivo')
        ? 'Pagarás en efectivo al retirar o recibir tu pedido. No se registrará como pagado hasta el cobro.'
        : 'Serás redirigido a Stripe para pagar de forma segura.';
        }

        function toggleQuickDelivery() {
        const isPickup = deliveryMethod.value === 'retiro';
        deliveryProfileBlock.hidden = isPickup;
        }

        productsGrid.addEventListener('click', event => {
        const button = event.target.closest('[data-product-id]');
        if (!button) return;
        selectProduct(button.dataset.productId);
        });

        productSearch.addEventListener('input', renderProducts);
        productSort.addEventListener('change', renderProducts);
        quantityInput.addEventListener('input', () => {
        if (selectedProduct && selectedProducts.has(Number(selectedProduct.id))) {
        selectedProducts.set(Number(selectedProduct.id), {
        product: selectedProduct,
        quantity: Math.max(1, Number(quantityInput.value || 1))
        });
        }
        updateSummary();
        });

        async function startStripeCheckout(orderIds) {
        const response = await fetch('/api/payments/stripe/checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ orderIds })
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || !result.url) throw new Error(result.message || 'No se pudo iniciar el pago seguro con Stripe.');
        window.location.assign(result.url);
        }

        async function startPayPalCheckout(orderIds) {
        const response = await fetch('/api/payments/paypal/checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ orderIds })
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || !result.url) throw new Error(result.message || 'No se pudo iniciar el pago seguro con PayPal.');
        window.location.assign(result.url);
        }
        deliveryMethod.addEventListener('change', toggleQuickDelivery);
        paymentMethod.addEventListener('change', syncPaymentFields);
        document.getElementById('clientMiniOrders').addEventListener('click', event => {
        const button = event.target.closest('[data-pay-deposit]');
        if (!button) return;
        const order = BakeSmartStore.orders.byClient(userEmail)
        .find(row => Number(row.id) === Number(button.dataset.payDeposit));
        if (!order) {
        app.toast.error('No se encontro el pedido para pagar el abono.');
        return;
        }
        openPaymentGateway(order.id, Number(order.total || 0), 'SINPE', 'deposit');
        });

        document.querySelectorAll('[data-payment-close]').forEach(button => {
        button.addEventListener('click', closePaymentGateway);
        });

        document.querySelectorAll('[data-address-close]').forEach(button => {
        button.addEventListener('click', closeAddressModal);
        });

        useSavedAddressBtn.addEventListener('click', () => {
        if (applySavedAddress()) {
        app.toast.success('Usaremos tu dirección guardada para este pedido.');
        continuePendingSubmit();
        }
        });

        useNewAddressBtn.addEventListener('click', () => {
        if (addressPicker) {
        addressPicker.applyToFields({
        address: 'quickAddress',
        lat: 'quickLat',
        lng: 'quickLng'
        });
        }

        if (manualAddressInput.value.trim()) {
        document.getElementById('quickAddress').value = manualAddressInput.value.trim();
        }

        document.getElementById('quickCustomerAddressId').value = '';

        if (!document.getElementById('quickAddress').value || !document.getElementById('quickLat').value || !document.getElementById('quickLng').value) {
        app.toast.error('Seleccione una ubicacion en el mapa para continuar.');
        return;
        }

        document.getElementById('quickProfileAddress').textContent = document.getElementById('quickAddress').value;
        continuePendingSubmit();
        });

        async function submitPaymentGateway() {
        if (!pendingPayment) return;

        const data = Object.fromEntries(new FormData(paymentForm).entries());
        if (String(data.method || '').toLowerCase().includes('paypal')) {
        try {
        paymentConfirmBtn.disabled = true;
        await startPayPalCheckout(pendingPayment.orderIds);
        } catch (error) {
        app.toast.error(error.message);
        } finally {
        paymentConfirmBtn.disabled = false;
        }
        return;
        }
        try {
        paymentConfirmBtn.disabled = true;
        if (String(data.method || '').toLowerCase().includes('tarjeta')) {
        await startStripeCheckout(pendingPayment.orderIds);
        return;
        }
        const isSinpe = String(data.method || '').toLowerCase().includes('sinpe');
        app.toast.success(isSinpe
        ? `Transferencia SINPE reportada para el pedido #${pendingPayment.orderId}. Se confirmará al validarla.`
        : `El pedido #${pendingPayment.orderId} se cobrará en efectivo al momento de la entrega.`);
        closePaymentGateway();
        } catch (error) {
        app.toast.error(error.message);
        } finally {
        paymentConfirmBtn.disabled = false;
        }
        }

        paymentConfirmBtn.addEventListener('click', () => { void submitPaymentGateway(); });
        paymentForm.addEventListener('submit', event => { event.preventDefault(); void submitPaymentGateway(); });

        form.addEventListener('submit', async (event) => {
        event.preventDefault();

        const data = Object.fromEntries(new FormData(form).entries());
        const isPickup = data.deliveryMethod === 'retiro';
        const quantity = Math.max(1, Number(data.quantity || 1));
        const product = selectedProduct || products.find(item => Number(item.id) === Number(data.productId));
        const orderItems = cartCheckoutItems.length
        ? cartCheckoutItems.map(item => ({ product: item.product, quantity: item.quantity, unitPrice: item.price }))
        : [...selectedProducts.values()].map(item => ({ product: item.product, quantity: item.quantity || quantity }));

        if (!orderItems.length || orderItems.some(item => !item.product)) {
        app.toast.error('Seleccione al menos un producto disponible.');
        return;
        }

        if (orderItems.some(item => item.quantity > item.product.stock)) {
        app.toast.error('La cantidad supera el stock disponible en uno de los articulos.');
        return;
        }

        if (!isPickup && (!data.address || !data.destinationLatitude || !data.destinationLongitude)) {
        await openAddressModal(true);
        return;
        }

        const originalSubmitLabel = submitBtn.innerHTML;
        try {
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Registrando y preparando pago seguro...';

        const taxRate = Number(BakeSmartStore.pos.config().iva || 0);
        const frequentRate = currentProfile?.isFrequent ? Number(BakeSmartStore.pos.config().frequentCustomerDiscount || 0) : 0;
        const promotionRate = Number(BakeSmartStore.pos.config().activePromotionDiscount || 0);
        const discountRate = Math.max(frequentRate, promotionRate);
        const createdOrders = await Promise.all(orderItems.map(async item => {
        const lineProduct = item.product;
        const lineQuantity = Math.max(1, Number(item.quantity || 1));
        const subtotal = Number(item.unitPrice || lineProduct.price) * lineQuantity;
        const discount = subtotal * discountRate;
        const discountedSubtotal = Math.max(0, subtotal - discount);
        const tax = discountedSubtotal * taxRate;
        const total = discountedSubtotal + tax;

        const result = await BakeSmartStore.createOrder({
        customerName: data.customerName,
        email: data.customerEmail,
        phone: data.customerPhone,
        productId: Number(lineProduct.id),
        quantity: lineQuantity,
        unitPrice: Number(item.unitPrice || lineProduct.price),
        subtotal,
        tax,
        total,
        deliveryDate: data.deliveryDate,
        address: isPickup ? null : data.address,
        notes: `${data.notes || ''}${item.comboName ? `\nCombo: ${item.comboName}.` : ''}${orderItems.length > 1 ? `\nPedido generado desde carrito (${lineProduct.name}).` : ''}`.trim() || null,
        paymentMethod: data.paymentMethod,
        destinationLatitude: isPickup ? null : Number(data.destinationLatitude),
        destinationLongitude: isPickup ? null : Number(data.destinationLongitude),
        deliveryReference: isPickup ? null : data.address,
        customerAddressId: isPickup ? null : (data.customerAddressId ? Number(data.customerAddressId) : null),
        deliveryMethod: data.deliveryMethod
        });
        return { ...result, total };
        }));

        const result = createdOrders[0];
        const total = createdOrders.reduce((sum, order) => sum + Number(order.total || 0), 0);

        await BakeSmartStore.refresh({ force: true });
        products = BakeSmartStore.inventory.list().map(normalizeProduct);
        document.getElementById('clientAvailableProducts').textContent =
        products.filter(item => item.active && isSellableProduct(item)).length;
        renderProducts();
        renderSummary();
        updateSummary();
        if (cartCheckoutItems.length) {
        clearCatalogCart();
        cartCheckoutItems = [];
        } else {
        selectedProducts.clear();
        selectedProduct = null;
        productInput.value = '';
        }
        const selectedPayment = String(data.paymentMethod || '').toLowerCase();
        if (selectedPayment.includes('tarjeta')) {
        await startStripeCheckout(createdOrders.map(order => Number(order.id)));
        return;
        }
        if (selectedPayment.includes('paypal')) {
        await startPayPalCheckout(createdOrders.map(order => Number(order.id)));
        return;
        }
        if (shouldOpenGateway(data.paymentMethod)) {
        openPaymentGateway(result.id, total, data.paymentMethod, 'full', createdOrders.map(order => Number(order.id)));
        } else {
        app.toast.warning(createdOrders.length > 1 ? 'Pedidos registrados desde el carrito. Puedes pagar cada abono desde Mis pedidos.' : 'Pedido registrado. Para iniciar producción se requiere un abono anticipado o pago en tienda.');
        }
        form.quantity.value = 1;
        form.notes.value = '';
        } catch (error) {
        app.toast.error(error.message);
        } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalSubmitLabel || '<i class="fas fa-receipt"></i> Registrar pedido';
        }
        });

        async function initializePage() {
        if (pageInitialized) return;
        pageInitialized = true;

        const tomorrow = new Date(Date.now() + 86400000).toISOString().slice(0, 10);
        form.deliveryDate.value = tomorrow;
        showPage();

        await Promise.all([
        loadProducts(),
        loadProfile()
        ]);
        toggleQuickDelivery();
        renderSummary();
        updateSummary();
        }

        app.page.ready(() => initializePage());
        })();
    </script>
}
