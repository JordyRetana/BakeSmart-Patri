@{
    ViewData["Title"] = "Carrito POS";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-shell pos-cart-page">
    <div class="page-header pos-cart-hero">
        <img class="pos-cart-hero__image" id="checkoutHeroImage" src="/img/products/producto-sin-imagen.svg" alt="Producto del pedido" />
        <div>
            <div class="eyebrow"><i class="fas fa-cash-register"></i> Punto de venta</div>
            <h1>Finalizar venta</h1>
            <p class="text-muted">Revise los productos, seleccione o escriba el cliente y confirme el cobro.</p>
        </div>
        <a class="btn btn-outline" href="/Pos">
            <i class="fas fa-arrow-left"></i>
            Volver al POS
        </a>
    </div>

    <div class="pos-cart-checkout-layout">
        <section class="card pos-cart-checkout-card">
            <div class="pos-panel-header">
                <div>
                    <div class="pos-panel-eyebrow">Detalle</div>
                    <h3 class="pos-panel-title"><i class="fas fa-cart-shopping"></i> Productos</h3>
                </div>
                <span class="badge badge-info" id="checkoutCartCount">0 productos</span>
            </div>
            <div id="checkoutCartItems" class="pos-cart-list"></div>
        </section>

        <aside class="card pos-cart-checkout-card pos-cart-checkout-card--payment">
            <div class="pos-panel-header">
                <div>
                    <div class="pos-panel-eyebrow">Cliente y cobro</div>
                    <h3 class="pos-panel-title">Datos de venta</h3>
                </div>
            </div>

            <form id="checkoutCartForm" class="pos-checkout-form">
                <div class="pos-form-block">
                    <label>Cliente</label>
                    <div class="pos-input-shell"><i class="fas fa-user"></i><input class="form-control" name="customerName" id="checkoutCustomerName" list="checkoutCustomerOptions" placeholder="Buscar cliente o escribir manualmente" required /></div>
                    <datalist id="checkoutCustomerOptions"></datalist>
                </div>
                <div class="pos-form-block">
                    <label>Correo</label>
                    <div class="pos-input-shell"><i class="fas fa-envelope"></i><input class="form-control" type="email" name="customerEmail" placeholder="correo@cliente.com" required /></div>
                </div>
                <div class="pos-form-block">
                    <label>Telefono</label>
                    <div class="pos-input-shell"><i class="fas fa-phone"></i><input class="form-control" name="customerPhone" placeholder="Telefono" required /></div>
                </div>
                <div class="pos-form-block">
                    <label>Metodo de pago</label>
                    <select class="form-control pos-payment-select" name="paymentMethod" id="checkoutPaymentMethod"></select>
                </div>
                <div class="pos-form-block">
                    <label>Promocion configurada</label>
                    <select class="form-control" name="promotionId" id="checkoutPromotion">
                        <option value="">Sin promocion</option>
                    </select>
                    <small class="text-muted">Solo se muestran beneficios vigentes para el cliente seleccionado.</small>
                </div>
                <div class="pos-form-block">
                    <label>Descuento adicional</label>
                    <div class="pos-input-shell"><i class="fas fa-tag"></i><input class="form-control" type="number" min="0" step="0.01" name="discountRate" value="0" /></div>
                </div>

                <div id="checkoutTotals" class="pos-cart-totals"></div>

                <button class="btn btn-primary pos-submit-btn" type="submit">
                    <i class="fas fa-check-circle"></i>
                    Confirmar venta
                </button>
            </form>
        </aside>
    </div>
</div>

<div class="pos-payment-modal" id="posPaymentModal" hidden>
    <div class="pos-payment-modal__backdrop" data-pos-payment-close></div>
    <section class="pos-payment-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="posPaymentTitle">
        <button class="pos-payment-modal__close" type="button" data-pos-payment-close aria-label="Cerrar">
            <i class="fas fa-xmark"></i>
        </button>
        <div class="pos-payment-modal__header">
            <span><i class="fas fa-shield-halved"></i></span>
            <div>
                <div class="pos-panel-eyebrow">Pasarela de pago</div>
                <h2 id="posPaymentTitle">Confirmar cobro</h2>
            </div>
        </div>
        <div class="pos-payment-modal__amount">
            <span>Total a cobrar</span>
            <strong id="posPaymentTotal">0</strong>
        </div>
        <div class="pos-payment-status" id="posPaymentStatus" aria-live="polite">
            <span class="pos-payment-status__icon"><i class="fas fa-lock"></i></span>
            <div>
                <strong>Pasarela lista</strong>
                <small>Seleccione el metodo y confirme el cobro.</small>
            </div>
        </div>
        <form id="posPaymentForm" class="pos-payment-form">
            <label>
                <span>Metodo</span>
                <select class="form-control" name="method" id="posGatewayMethod">
                    <option>Tarjeta</option>
                    <option>PayPal</option>
                    <option>SINPE</option>
                    <option>Efectivo</option>
                    <option>Transferencia</option>
                </select>
            </label>
            <label>
                <span id="posGatewayReferenceLabel">Referencia o titular</span>
                <input class="form-control" name="holder" id="posGatewayReference" placeholder="Nombre, SINPE o referencia" required />
            </label>
            <label class="pos-card-field">
                <span>Numero de tarjeta</span>
                <input class="form-control" name="card" inputmode="numeric" maxlength="19" placeholder="4242 4242 4242 4242" />
            </label>
            <div class="pos-payment-form__grid pos-card-field">
                <label><span>Vence</span><input class="form-control" name="expiry" maxlength="5" placeholder="MM/AA" /></label>
                <label><span>CVV</span><input class="form-control" name="cvv" inputmode="numeric" maxlength="4" placeholder="123" /></label>
            </div>
            <p class="pos-payment-modal__note">Simulacion de pasarela: valida datos minimos y registra el cobro en el sistema.</p>
            <button class="btn btn-primary pos-submit-btn" type="submit" id="posPaymentConfirmBtn">
                <i class="fas fa-lock"></i>
                Aprobar cobro
            </button>
        </form>
    </section>
</div>

@section Scripts {
    <script>
        (() => {
            const store = BakeSmartStore;
            const fmt = app.utils.formatCurrency;
            function readCartSnapshot() {
                try {
                    return JSON.parse(sessionStorage.getItem('bakesmart.pos.cart') || localStorage.getItem('bakesmart.pos.cart') || '[]');
                } catch {
                    return [];
                }
            }

            let cart = readCartSnapshot();

            const itemsEl = document.getElementById('checkoutCartItems');
            const countEl = document.getElementById('checkoutCartCount');
            const totalsEl = document.getElementById('checkoutTotals');
            const form = document.getElementById('checkoutCartForm');
            const paymentModal = document.getElementById('posPaymentModal');
            const paymentForm = document.getElementById('posPaymentForm');
            const gatewayMethod = document.getElementById('posGatewayMethod');
            const gatewayReferenceLabel = document.getElementById('posGatewayReferenceLabel');
            const gatewayReference = document.getElementById('posGatewayReference');
            const paymentConfirmBtn = document.getElementById('posPaymentConfirmBtn');
            const paymentStatus = document.getElementById('posPaymentStatus');
            const checkoutHeroImage = document.getElementById('checkoutHeroImage');
            let pendingOrder = null;
            let pendingTotals = null;

            function saveCart() {
                const payload = JSON.stringify(cart);
                try { sessionStorage.setItem('bakesmart.pos.cart', payload); } catch { }
                try { localStorage.setItem('bakesmart.pos.cart', payload); } catch { }
            }

            function renderCustomers() {
                document.getElementById('checkoutCustomerOptions').innerHTML = store.customers.list().map(customer => `
                            <option value="${customer.fullName || customer.name || ''}">
                                ${customer.email || customer.phone || 'Cliente registrado'}
                            </option>
                        `).join('');
            }

            function renderPayments() {
                const activeMethods = store.pos.config().paymentMethods
                    .filter(method => method.active)
                    .map(method => method.name);

                const fallbackMethods = ['Efectivo', 'SINPE', 'Transferencia', 'Tarjeta', 'PayPal'];
                const methods = activeMethods.length ? activeMethods : fallbackMethods;
                const options = methods.map(name => `<option value="${name}">${name}</option>`).join('');
                const checkoutPaymentMethod = document.getElementById('checkoutPaymentMethod');
                const previousCheckoutMethod = checkoutPaymentMethod.value;
                const previousGatewayMethod = gatewayMethod.value;
                checkoutPaymentMethod.innerHTML = options;
                gatewayMethod.innerHTML = options;
                checkoutPaymentMethod.value = methods.includes(previousCheckoutMethod) ? previousCheckoutMethod : methods[0];
                gatewayMethod.value = methods.includes(previousGatewayMethod) ? previousGatewayMethod : checkoutPaymentMethod.value;
                app.selects?.enhanceAll?.();
                app.selects?.refresh?.(checkoutPaymentMethod);
                app.selects?.refresh?.(gatewayMethod);
                checkoutPaymentMethod.dispatchEvent(new Event('change', { bubbles: true }));
                gatewayMethod.dispatchEvent(new Event('change', { bubbles: true }));
            }

            function readPendingOrder() {
                try {
                    const raw = sessionStorage.getItem('bakesmart.pos.pendingOrder');
                    pendingOrder = raw ? JSON.parse(raw) : null;
                } catch {
                    pendingOrder = null;
                }

                if (!pendingOrder) return;
                form.customerName.value = pendingOrder.customerName || '';
                form.customerEmail.value = pendingOrder.customerEmail || '';
                if (pendingOrder.paymentMethod) {
                    form.paymentMethod.value = pendingOrder.paymentMethod;
                    form.paymentMethod.dispatchEvent(new Event('change', { bubbles: true }));
                }
            }

            function selectedCustomer() {
                const email = String(form.customerEmail.value || '').trim().toLowerCase();
                const name = String(form.customerName.value || '').trim().toLowerCase();
                return store.customers.list().find(row =>
                    (email && String(row.email || '').trim().toLowerCase() === email) ||
                    (name && String(row.fullName || row.name || '').trim().toLowerCase() === name)
                );
            }

            function normalizeDiscountRate(value) {
                const numeric = Number(value || 0);
                if (!Number.isFinite(numeric) || numeric <= 0) return 0;
                return Math.min(numeric > 1 ? numeric / 100 : numeric, 1);
            }

            function currentDiscountBreakdown(subtotal) {
                const manual = normalizeDiscountRate(form.discountRate?.value);
                const customer = selectedCustomer();
                const frequent = customer?.frequent ? Math.min(Math.max(Number(store.pos.config().frequentCustomerDiscount || 0), 0), 1) : 0;
                const promotion = store.marketing.promotions().find(row => String(row.id) === document.getElementById('checkoutPromotion').value);
                const eligibleIds = new Set((promotion?.productIds || []).map(Number));
                const promotionBase = promotion ? cart.reduce((sum, item) => {
                    if (!eligibleIds.size) return sum + Number(item.quantity) * Number(item.unitPrice);
                    if (!item.isCombo) return sum + (eligibleIds.has(Number(item.productId)) ? Number(item.quantity) * Number(item.unitPrice) : 0);
                    const combo = comboFor(item);
                    const regular = (combo?.items || []).reduce((value, component) => value + Number(component.unitPrice) * Number(component.quantity), 0);
                    const eligible = (combo?.items || []).filter(component => eligibleIds.has(Number(component.productId))).reduce((value, component) => value + Number(component.unitPrice) * Number(component.quantity), 0);
                    return sum + Number(item.quantity) * Number(item.unitPrice) * (regular > 0 ? eligible / regular : 0);
                }, 0) : 0;
                const promotionAmount = promotionBase * Number(promotion?.discount || 0);
                const manualAmount = subtotal * manual;
                const frequentAmount = subtotal * frequent;
                const discountAmount = Math.max(manualAmount, frequentAmount, promotionAmount);
                return { manual, frequent, promotion, promotionAmount, discountAmount, totalRate: subtotal > 0 ? discountAmount / subtotal : 0, customer };
            }

            function remainingStock(productId) {
                const product = store.inventory.list().find(row => Number(row.id) === Number(productId));
                const item = cart.find(row => Number(row.productId) === Number(productId));
                return Math.max(0, Number(product?.stock || 0) - Number(item?.quantity || 0));
            }

            function renderPromotions() {
                const select = document.getElementById('checkoutPromotion');
                const selected = select.value;
                const customer = selectedCustomer();
                const today = new Date().toISOString().slice(0, 10);
                const rows = store.marketing.promotions().filter(promotion => promotion.active
                    && (!promotion.startDate || promotion.startDate <= today)
                    && (!promotion.endDate || promotion.endDate >= today)
                    && (!(promotion.customerIds || []).length || (customer && promotion.customerIds.map(Number).includes(Number(customer.id)))));
                select.innerHTML = '<option value="">Sin promocion</option>' + rows.map(promotion =>
                    `<option value="${promotion.id}">${promotion.name} · ${Math.round(Number(promotion.discount || 0) * 100)}%</option>`
                ).join('');
                select.value = rows.some(row => String(row.id) === selected) ? selected : '';
                app.selects?.refresh?.(select);
            }

            function itemKey(item) {
                return item?.isCombo ? `combo-${item.comboId}` : String(item?.productId);
            }

            function comboFor(item) {
                return item?.isCombo ? store.combos.list().find(row => Number(row.id) === Number(item.comboId)) : null;
            }

            function remainingItemStock(item) {
                const combo = comboFor(item);
                if (!combo) return remainingStock(item.productId);
                const availability = (combo.items || []).map(component => {
                    const product = store.inventory.list().find(row => Number(row.id) === Number(component.productId));
                    const used = cart.reduce((sum, row) => {
                        if (!row.isCombo) return sum + (Number(row.productId) === Number(component.productId) ? Number(row.quantity || 0) : 0);
                        const rowComponent = comboFor(row)?.items?.find(value => Number(value.productId) === Number(component.productId));
                        return sum + Number(row.quantity || 0) * Number(rowComponent?.quantity || 0);
                    }, 0);
                    return Math.floor((Number(product?.stock || 0) - used) / Math.max(1, Number(component.quantity || 1)));
                });
                return Math.max(0, availability.length ? Math.min(...availability) : 0);
            }

            function renderCart() {
                countEl.textContent = `${cart.length} producto${cart.length === 1 ? '' : 's'}`;

                if (!cart.length) {
                    if (checkoutHeroImage) checkoutHeroImage.src = '/img/products/producto-sin-imagen.svg';
                    itemsEl.innerHTML = `<div class="pos-cart-mini-empty"><i class="fas fa-basket-shopping"></i><strong>Carrito vacío</strong><span>Vuelva al POS para agregar productos.</span></div>`;
                    totalsEl.innerHTML = '';
                    return;
                }

                const firstProduct = store.inventory.list().find(row => Number(row.id) === Number(cart[0]?.productId) || String(row.code || '').toLowerCase() === String(cart[0]?.code || '').toLowerCase());
                const firstImage = cart[0]?.imageUrl || comboFor(cart[0])?.imageUrl || firstProduct?.imageUrl || '/img/products/producto-sin-imagen.svg';
                if (checkoutHeroImage) checkoutHeroImage.src = firstImage;

                itemsEl.innerHTML = cart.map(item => {
                    const key = itemKey(item);
                    const combo = comboFor(item);
                    const inventoryProduct = store.inventory.list().find(row => Number(row.id) === Number(item.productId) || String(row.code || '').toLowerCase() === String(item.code || '').toLowerCase());
                    const imageUrl = item.imageUrl || combo?.imageUrl || item.image || item.photo || inventoryProduct?.imageUrl || inventoryProduct?.image || '/img/products/producto-sin-imagen.svg';
                    const composition = combo?.items?.map(component => `${component.quantity}× ${component.name}`).join(' · ');
                    return `
                            <div class="pos-cart-item">
                                <img class="pos-cart-item-image" src="${imageUrl}" alt="${item.name}" />
                                <div class="pos-cart-item-body">
                                <div class="pos-cart-item-header">
                                    <div>
                                        <strong>${item.name}</strong>
                                        ${composition ? `<div class="text-muted" style="font-size:.78rem;">Incluye ${composition}</div>` : ''}
                                        <div class="text-muted" style="font-size:.82rem;">${item.code} · ${fmt(item.unitPrice)} c/u · ${remainingItemStock(item)} adicionales disponibles</div>
                                    </div>
                                    <button class="btn btn-ghost btn-sm" type="button" onclick='removeCheckoutItem(${JSON.stringify(key)})'>
                                        <i class="fas fa-trash-can"></i>
                                    </button>
                                </div>
                                <div class="pos-cart-item-footer">
                                    <div class="pos-cart-actions">
                                        <button class="btn btn-outline btn-sm" type="button" onclick='changeCheckoutQty(${JSON.stringify(key)}, -1)'><i class="fas fa-minus"></i></button>
                                        <span style="font-weight:800;min-width:24px;text-align:center;">${item.quantity}</span>
                                        <button class="btn btn-outline btn-sm" type="button" onclick='changeCheckoutQty(${JSON.stringify(key)}, 1)' ${remainingItemStock(item) <= 0 ? 'disabled' : ''}><i class="fas fa-plus"></i></button>
                                    </div>
                                    <strong style="color:var(--primary);">${fmt(item.quantity * item.unitPrice)}</strong>
                                </div>
                                </div>
                            </div>
                        `;
                }).join('');

                const subtotal = cart.reduce((sum, item) => sum + item.quantity * item.unitPrice, 0);
                const discountBreakdown = currentDiscountBreakdown(subtotal);
                const discountRate = discountBreakdown.totalRate;
                const discount = discountBreakdown.discountAmount;
                const discountedSubtotal = Math.max(0, subtotal - discount);
                const tax = discountedSubtotal * Number(store.pos.config().iva || 0);
                const total = pendingOrder?.total ? Number(pendingOrder.total) : discountedSubtotal + tax;
                pendingTotals = { subtotal, discount, tax, total };
                totalsEl.innerHTML = `
                            ${pendingOrder ? `<div class="pos-total-row"><span>Pedido existente</span><strong>#${pendingOrder.id}</strong></div>` : ''}
                            <div class="pos-total-row"><span>Subtotal</span><strong>${fmt(subtotal)}</strong></div>
                            ${discountBreakdown.frequent > 0 ? `<div class="pos-total-row"><span>Cliente frecuente ${Math.round(discountBreakdown.frequent * 100)}%</span><strong>Aplica</strong></div>` : `<div class="pos-total-row"><span>Cliente frecuente</span><strong>0%</strong></div>`}
                            ${discountBreakdown.manual > 0 ? `<div class="pos-total-row"><span>Descuento adicional ${Math.round(discountBreakdown.manual * 100)}%</span><strong>Aplica</strong></div>` : ''}
                            ${discountBreakdown.promotion ? `<div class="pos-total-row"><span>${discountBreakdown.promotion.name}</span><strong>-${fmt(discountBreakdown.promotionAmount)}</strong></div>` : ''}
                            ${discount > 0 ? `<div class="pos-total-row"><span>Descuento total ${Math.round(discountRate * 100)}%</span><strong>-${fmt(discount)}</strong></div>` : ''}
                            <div class="pos-total-row"><span>IVA</span><strong>${fmt(tax)}</strong></div>
                            <div class="hr"></div>
                            <div class="pos-total-row total-final"><span>Total</span><strong>${fmt(total)}</strong></div>
                        `;
            }

            function shouldShowCardFields(method) {
                const value = String(method || '').toLowerCase();
                return value.includes('tarjeta');
            }

            function syncGatewayFields() {
                const show = shouldShowCardFields(gatewayMethod.value);
                document.querySelectorAll('.pos-card-field').forEach(field => {
                    field.hidden = !show;
                    field.classList.toggle('is-hidden', !show);
                    field.style.setProperty('display', show ? '' : 'none', 'important');
                    field.querySelectorAll('input').forEach(input => {
                        input.disabled = !show;
                        input.required = show;
                        if (!show) input.value = '';
                    });
                });

                const method = String(gatewayMethod.value || '').toLowerCase();
                if (method.includes('efectivo')) {
                    gatewayReferenceLabel.textContent = 'Recibido por';
                    gatewayReference.placeholder = 'Nombre de quien recibe el efectivo';
                    gatewayReference.required = true;
                } else if (method.includes('sinpe')) {
                    gatewayReferenceLabel.textContent = 'Referencia SINPE';
                    gatewayReference.placeholder = 'Telefono o comprobante SINPE';
                    gatewayReference.required = true;
                } else if (method.includes('transfer')) {
                    gatewayReferenceLabel.textContent = 'Referencia de transferencia';
                    gatewayReference.placeholder = 'Numero de comprobante o banco';
                    gatewayReference.required = true;
                } else {
                    gatewayReferenceLabel.textContent = 'Titular de la tarjeta';
                    gatewayReference.placeholder = 'Nombre del titular';
                    gatewayReference.required = true;
                }
            }

            function setPaymentStatus(state, title, message, icon) {
                paymentModal.dataset.state = state;
                paymentStatus.innerHTML = `
                    <span class="pos-payment-status__icon"><i class="fas ${icon}"></i></span>
                    <div>
                        <strong>${title}</strong>
                        <small>${message}</small>
                    </div>
                `;
            }

            function openPaymentModal() {
                if (paymentModal.parentElement !== document.body) {
                    document.body.appendChild(paymentModal);
                }
                const selectedMethod = form.paymentMethod.value || gatewayMethod.options[0]?.value || 'Efectivo';
                const method = String(selectedMethod).toLowerCase();
                const normalizedMethod = method.includes('sinpe') ? 'SINPE'
                    : method.includes('efectivo') ? 'Efectivo'
                    : method.includes('transfer') ? 'Transferencia'
                    : 'Tarjeta';
                gatewayMethod.value = [...gatewayMethod.options].some(option => option.value === normalizedMethod)
                    ? normalizedMethod
                    : selectedMethod;
                document.getElementById('posPaymentTotal').textContent = fmt(pendingTotals?.total || 0);
                paymentForm.holder.value = form.customerName.value || '';
                gatewayMethod.dispatchEvent(new Event('change', { bubbles: true }));
                app.selects?.refresh?.(gatewayMethod);
                syncGatewayFields();
                setPaymentStatus('ready', 'Pasarela lista', 'Seleccione el metodo y confirme el cobro.', 'fa-lock');
                paymentModal.hidden = false;
            }

            function closePaymentModal() {
                paymentModal.hidden = true;
                paymentForm.reset();
                syncGatewayFields();
            }

            window.changeCheckoutQty = (key, delta) => {
                const item = cart.find(row => itemKey(row) === String(key));
                if (!item) return;
                if (delta > 0 && remainingItemStock(item) <= 0) {
                    app.toast.warning('La cantidad supera el stock disponible.');
                    return;
                }
                item.quantity += delta;
                if (item.quantity <= 0) cart = cart.filter(row => itemKey(row) !== String(key));
                saveCart();
                renderCart();
            };

            window.removeCheckoutItem = (key) => {
                cart = cart.filter(row => itemKey(row) !== String(key));
                saveCart();
                renderCart();
            };

            document.getElementById('checkoutCustomerName').addEventListener('change', event => {
                const selected = store.customers.list().find(customer =>
                    String(customer.fullName || customer.name || '').toLowerCase() === String(event.target.value || '').toLowerCase()
                );
                if (!selected) return;
                form.customerEmail.value = selected.email || '';
                form.customerPhone.value = selected.phone || '';
                renderPromotions();
                renderCart();
            });

            form.discountRate.addEventListener('input', renderCart);
            form.customerEmail.addEventListener('input', renderCart);
            form.customerName.addEventListener('input', renderCart);
            document.getElementById('checkoutPromotion').addEventListener('change', renderCart);

            async function startStripeCheckout(orderIds) {
                const response = await fetch('/api/payments/stripe/checkout', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ orderIds })
                });
                const result = await response.json().catch(() => ({}));
                if (!response.ok || !result.url) {
                    throw new Error(result.message || 'No fue posible iniciar el pago seguro con tarjeta.');
                }
                window.location.assign(result.url);
            }

            async function startPayPalCheckout(orderIds) {
                const response = await fetch('/api/payments/paypal/checkout', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ orderIds })
                });
                const result = await response.json().catch(() => ({}));
                if (!response.ok || !result.url) throw new Error(result.message || 'No fue posible iniciar el pago seguro con PayPal.');
                window.location.assign(result.url);
            }

            async function completeCheckout(paymentData) {
                try {
                    await store.pos.sessions();
                    if (!pendingOrder && !store.pos.activeSession()) throw new Error('Debe abrir caja antes de confirmar ventas.');
                    if (!cart.length) throw new Error('Agregue productos al carrito antes de cobrar.');

                    if (pendingOrder) {
                        await store.orders.markPaid(pendingOrder.id, paymentData.method || form.paymentMethod.value || 'Tarjeta');
                        sessionStorage.removeItem('bakesmart.pos.pendingOrder');
                    } else {
                        await store.pos.sell({
                            ...Object.fromEntries(new FormData(form).entries()),
                            paymentMethod: paymentData.method || form.paymentMethod.value,
                            items: cart.filter(item => !item.isCombo).map(item => ({ productId: Number(item.productId), quantity: Number(item.quantity) })),
                            combos: cart.filter(item => item.isCombo).map(item => ({ comboId: Number(item.comboId), quantity: Number(item.quantity) }))
                        });
                    }

                    cart = [];
                    saveCart();
                    return {
                        message: pendingOrder ? 'Pago del pedido confirmado.' : 'Venta registrada correctamente.',
                        redirectUrl: pendingOrder ? '/Production' : '/Pos'
                    };
                } catch (error) {
                    app.toast.error(error.message);
                    throw error;
                }
            }

            form.addEventListener('submit', async event => {
                event.preventDefault();
                try {
                    if (!cart.length) throw new Error('Agregue productos al carrito antes de cobrar.');
                    if (!form.reportValidity()) {
                        app.toast.error('Complete los datos del cliente antes de cobrar.');
                        return;
                    }
                    openPaymentModal();
                } catch (error) {
                    app.toast.error(error.message);
                }
            });

            gatewayMethod.addEventListener('change', syncGatewayFields);
            document.querySelectorAll('[data-pos-payment-close]').forEach(button => button.addEventListener('click', closePaymentModal));

            paymentForm.addEventListener('submit', async event => {
                event.preventDefault();
                const data = Object.fromEntries(new FormData(paymentForm).entries());
                const method = String(data.method || gatewayMethod.value || '').trim();
                data.method = method;
                if (!method) {
                    app.toast.error('Seleccione un metodo de pago.');
                    return;
                }
                if (pendingOrder && method.toLowerCase().includes('paypal')) {
                    try {
                        paymentConfirmBtn.disabled = true;
                        paymentConfirmBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Redirigiendo a PayPal';
                        setPaymentStatus('processing', 'Abriendo pago seguro', 'Será redirigido a PayPal para completar el cobro.', 'fa-spinner fa-spin');
                        await startPayPalCheckout([Number(pendingOrder.id)]);
                    } catch (error) {
                        app.toast.error(error.message || 'No fue posible iniciar el pago seguro.');
                        paymentConfirmBtn.disabled = false;
                        paymentConfirmBtn.innerHTML = '<i class="fas fa-lock"></i> Aprobar cobro';
                    }
                    return;
                }
                if (pendingOrder && shouldShowCardFields(method)) {
                    try {
                        paymentConfirmBtn.disabled = true;
                        paymentConfirmBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Redirigiendo a Stripe';
                        setPaymentStatus('processing', 'Abriendo pago seguro', 'Será redirigido a Stripe para completar el cobro.', 'fa-spinner fa-spin');
                        await startStripeCheckout([Number(pendingOrder.id)]);
                    } catch (error) {
                        app.toast.error(error.message || 'No fue posible iniciar el pago seguro.');
                        paymentConfirmBtn.disabled = false;
                        paymentConfirmBtn.innerHTML = '<i class="fas fa-lock"></i> Aprobar cobro';
                        setPaymentStatus('error', 'No se pudo abrir Stripe', 'Intente nuevamente o seleccione otro método de pago.', 'fa-triangle-exclamation');
                    }
                    return;
                }
                if (!String(data.holder || '').trim()) {
                    app.toast.error('Complete la referencia del pago.');
                    gatewayReference.focus();
                    return;
                }
                if (shouldShowCardFields(data.method)) {
                    const digits = String(data.card || '').replace(/\D/g, '');
                    if (digits.length < 12 || !data.expiry || !data.cvv) {
                        app.toast.error('Complete los datos de tarjeta para aprobar el cobro.');
                        return;
                    }
                }

                try {
                    paymentConfirmBtn.disabled = true;
                    paymentConfirmBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Procesando cobro';
                    setPaymentStatus('processing', 'Procesando pago', 'Validando datos y registrando el movimiento contable.', 'fa-spinner fa-spin');
                    await new Promise(resolve => setTimeout(resolve, 650));
                    const result = await completeCheckout(data);
                    setPaymentStatus('success', 'Pago aprobado', 'La venta quedo registrada y el inventario fue actualizado.', 'fa-circle-check');
                    app.toast.success(result.message);
                    window.setTimeout(() => {
                        window.location.assign(result.redirectUrl);
                    }, 900);
                } catch {
                    // completeCheckout already reports the error.
                    setPaymentStatus('error', 'No se pudo aprobar', 'Revise los datos del pago e intente nuevamente.', 'fa-triangle-exclamation');
                } finally {
                    if (paymentModal.dataset.state !== 'success') {
                        paymentConfirmBtn.disabled = false;
                        paymentConfirmBtn.innerHTML = '<i class="fas fa-lock"></i> Aprobar cobro';
                    }
                }
            });

            async function initializeCheckout() {
                try {
                    await store.pos.sessions();
                    await store.refresh({ keys: ['inventory', 'customers', 'posConfig', 'promotions', 'combos'], force: true });
                    renderCustomers();
                    renderPayments();
                    readPendingOrder();
                    renderPromotions();
                    renderCart();
                } catch (error) {
                    app.toast.error(error.message);
                }
            }

            initializeCheckout();
        })();
    </script>
}

