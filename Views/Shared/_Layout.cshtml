    <button id="chat-toggle-btn" type="button" aria-label="Abrir asistente Richie" aria-expanded="false" aria-controls="chat-widget"><img src="~/img/richie-bot.png" alt="" /></button>

    <div id="chat-widget">
        <div id="chat-header">
            <div class="avatar"><img src="~/img/richie-bot.png" alt="Richie" /></div>
            <div>
                <strong>Richie</strong>
                <small>Asistente pastelero</small>
            </div>
        </div>
        <div id="chat-box"></div>
        <div id="chat-input-row">
            <input id="chat-input" placeholder="Pregunta por queques, cupcakes o pedidos..." />
            <button id="chat-send" aria-label="Enviar"><i class="fas fa-paper-plane"></i></button>
        </div>
    </div>

    <script>
        (function () {
        const toggleBtn = document.getElementById('chat-toggle-btn');
        const widget = document.getElementById('chat-widget');
        const box = document.getElementById('chat-box');
        const input = document.getElementById('chat-input');
        const sendBtn = document.getElementById('chat-send');
        const historyKey = 'bakesmart:richie-history-v2';
        const transcriptKey = 'bakesmart:richie-transcript-v2';
        const widgetStateKey = 'bakesmart:richie-widget-open-v2';
        const legacyKeys = ['bakesmart:richie-history', 'bakesmart:richie-transcript', 'bakesmart:richie-widget-open'];
        legacyKeys.forEach(key => {
        sessionStorage.removeItem(key);
        localStorage.removeItem(key);
        });
        const isUnsafeTechnicalText = value => {
        const text = String(value || '');
        return text.length > 1400 || /(?:<!doctype|<\/?html|<\/?head|<\/?body|<\/?script|box\.appendChild|function\s+addNavigation|const\s+typingEl|window\.location\.pathname)/i.test(text);
        };
        const safeChatText = value => isUnsafeTechnicalText(value)
        ? 'Richie no pudo procesar esa respuesta. Intenta nuevamente en un momento.'
        : String(value || '');
        let history = [];
        let transcript = [];
        let requestedQuantity = 1;

        // Keep the conversation when navigating in this tab, including login.
        // A full refresh deliberately starts a fresh conversation.
        const navigation = performance.getEntriesByType('navigation')[0];
        if (navigation?.type === 'reload') {
        sessionStorage.removeItem(historyKey);
        sessionStorage.removeItem(transcriptKey);
        sessionStorage.removeItem(widgetStateKey);
        localStorage.removeItem(historyKey);
        }

        try {
        const saved = JSON.parse(sessionStorage.getItem(historyKey) || '[]');
        history = Array.isArray(saved) ? saved.slice(-10) : [];
        } catch { history = []; }

        try {
        const savedTranscript = JSON.parse(sessionStorage.getItem(transcriptKey) || '[]');
        transcript = Array.isArray(savedTranscript) ? savedTranscript.slice(-30) : [];
        } catch { transcript = []; }

        function saveHistory() {
        sessionStorage.setItem(historyKey, JSON.stringify(history.slice(-10)));
        sessionStorage.setItem(transcriptKey, JSON.stringify(transcript.slice(-30)));
        }

        function renderMessage(role, text) {
        const div = document.createElement('div');
        div.className = 'msg ' + role;
        div.textContent = safeChatText(text);
        box.appendChild(div);
        box.scrollTop = box.scrollHeight;
        return div;
        }

        function restoreConversation() {
        // Never render stale technical content that may have been left by an older
        // chatbot build in this tab's session storage.
        const isSafeTranscriptItem = item => !isUnsafeTechnicalText(item?.text);
        transcript = transcript.filter(isSafeTranscriptItem);
        history = history.filter(item => !isUnsafeTechnicalText(item?.content));
        saveHistory();
        transcript.forEach(item => renderMessage(item.role, item.text));
        if (sessionStorage.getItem(widgetStateKey) === 'true' && transcript.length) {
        widget.classList.add('open');
        toggleBtn.setAttribute('aria-expanded', 'true');
        }
        }

        restoreConversation();

        toggleBtn.addEventListener('click', () => {
        widget.classList.toggle('open');
        toggleBtn.setAttribute('aria-expanded', widget.classList.contains('open') ? 'true' : 'false');
        sessionStorage.setItem(widgetStateKey, String(widget.classList.contains('open')));
        if (widget.classList.contains('open') && box.children.length === 0) {
        addMsg('bot', 'Hola, soy Richie 🧁 ¿Buscamos algo dulce para hoy?');
        }
        });

        function addMsg(role, text) {
        const normalizedText = safeChatText(text);
        const div = renderMessage(role, normalizedText);
        if (role !== 'typing') {
        transcript.push({ role, text: normalizedText });
        saveHistory();
        }
        return div;
        }

        const money = value => `₡${Number(value || 0).toLocaleString('es-CR')}`;
        function askToContinueShopping(products) {
        const actions = document.createElement('div');
        actions.className = 'chat-cart-actions';
        actions.innerHTML = '<button type="button" data-chat-continue>Agregar mas productos</button><button type="button" data-chat-cart>Ver carrito</button>';
        actions.addEventListener('click', event => {
        if (event.target.closest('[data-chat-continue]')) {
        actions.remove();
        addMsg('bot', 'Claro, aqui tienes nuevamente los productos disponibles.');
        addProductTable(products);
        return;
        }
        if (event.target.closest('[data-chat-cart]')) window.location.assign('/Catalog/Cart');
        });
        box.appendChild(actions);
        box.scrollTop = box.scrollHeight;
        }

        function addProductTable(products) {
        if (!Array.isArray(products) || !products.length) return;
        const card = document.createElement('div'); card.className = 'chat-products';
        const rows = products.map(p => `<tr><td>${String(p.name || '').replace(/[&<>"']/g, '')}</td><td>${money(p.price)}</td><td><button data-chat-add="${Number(p.id)}" data-name="${String(p.name || '').replace(/"/g,'') }" data-price="${Number(p.price)}">Agregar</button></td></tr>`).join('');
        card.innerHTML = `<strong>Productos disponibles</strong><div class="chat-products-scroll"><table><thead><tr><th>Producto</th><th>Precio</th><th></th></tr></thead><tbody>${rows}</tbody></table></div>`;
        card.addEventListener('click', event => {
            const button = event.target.closest('[data-chat-add]');
            if (!button) return;

            const product = {
                id: Number(button.dataset.chatAdd),
                name: button.dataset.name,
                price: Number(button.dataset.price)
            };
            const qty = Math.max(1, requestedQuantity);
            const addToCart = () => {
                const email = (document.body.dataset.userEmail || '').trim().toLowerCase();
                const key = `bakesmart:catalog-cart:${email || 'guest'}`;
                let cart = [];
                try { cart = JSON.parse(localStorage.getItem(key) || '[]'); } catch { }

                const item = cart.find(x => Number(x.id) === product.id && !x.isCombo);
                if (item) item.quantity = Number(item.quantity || 0) + qty;
                else cart.push({ ...product, quantity: qty });

                localStorage.setItem(key, JSON.stringify(cart));
                window.dispatchEvent(new CustomEvent('bakesmart:cart-updated', {
                    detail: { count: cart.reduce((total, row) => total + Math.max(1, Number(row?.quantity || 1)), 0) }
                }));
                card.remove();
                const cartQuantity = cart.reduce((total, cartItem) => total + Number(cartItem.quantity || 0), 0);
                const cartTotal = cart.reduce((total, cartItem) => total + Number(cartItem.price || 0) * Number(cartItem.quantity || 0), 0);
                addMsg('bot', `${qty} × ${product.name} se agregaron. Carrito actual: ${cartQuantity} producto(s) por ${money(cartTotal)}.`);
                askToContinueShopping(products);
            };

            app.modal.create({
                title: 'Agregar al carrito',
                message: `${qty} × ${product.name} serían ${money(product.price * qty)}. ¿Deseas agregarlos al carrito?`,
                confirmText: 'Agregar al carrito',
                cancelText: 'Cancelar',
                onConfirm: addToCart
            });
        });
        box.appendChild(card); box.scrollTop = box.scrollHeight;
        }
        function addNavigation(action) {
        if (!action?.url || !action?.label) return; const link=document.createElement('a'); link.className='chat-action-link'; link.href=action.url; link.textContent=action.label; box.appendChild(link); box.scrollTop=box.scrollHeight;
        }

        function isAffirmative(value) {
        return /^(si|sí|dale|ok|okay|claro|continuar|quiero|por favor|sipi)\b/i.test(value.trim());
        }

        function lastAssistantAskedForLogin() {
        const previous = [...history].reverse().find(item => item.role === 'assistant');
        return previous && /(inicia|iniciar|inicie).*sesion|sesión.*inicia/i.test(previous.content);
        }

        function requestsLogin(value) {
        return /\b(login|iniciar\s+sesi[oó]n|inicie\s+sesi[oó]n|entrar\s+a\s+mi\s+cuenta|acceder\s+a\s+mi\s+cuenta)\b/i.test(value);
        }

        function offerLogin() {
        addMsg('bot', 'Claro. Cuando estés listo, usa este botón para iniciar sesión y continuar.');
        addNavigation({
        label: 'Ir a iniciar sesión',
        url: `/Account/Login?ReturnUrl=${encodeURIComponent(window.location.pathname + window.location.search)}`
        });
        }

        async function send() {
        const msg = input.value.trim();
        if (!msg) return;
        input.value = '';
        requestedQuantity = Number((msg.match(/\b(\d+)\b/) || [])[1] || 1);
        addMsg('user', msg);

        if (requestsLogin(msg)) {
        history.push({ role: 'user', content: msg });
        saveHistory();
        offerLogin();
        return;
        }

        if (isAffirmative(msg) && lastAssistantAskedForLogin()) {
        history.push({ role: 'user', content: msg });
        saveHistory();
        offerLogin();
        return;
        }
        const typingEl = addMsg('typing', 'Richie esta decorando la respuesta... 🍰');

        try {
        const res = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: msg, history, page: window.location.pathname })
        });
        const contentType = res.headers.get('content-type') || '';
        if (!contentType.includes('application/json')) throw new Error('Respuesta no válida del asistente.');
        const data = await res.json();
        typingEl.remove();
        if (!res.ok) throw new Error(data.message || 'Richie no pudo responder.');
        const reply = safeChatText(data.reply);
        history.push({ role: 'user', content: msg }, { role: 'assistant', content: reply });
        saveHistory();
        addMsg('bot', reply);
        addProductTable(data.products);
        addNavigation(data.navigation);
        } catch (err) {
        typingEl.remove();
        addMsg('bot', 'Uy, se me cayo un poquito de merengue 🍰 Proba de nuevo en un momento.');
        }
        }

        sendBtn.addEventListener('click', send);
        input.addEventListener('keypress', e => { if (e.key === 'Enter') send(); });
        })();
    </script>
    <script>
        (() => {
            const email = (document.body.dataset.userEmail || '').trim().toLowerCase() || 'guest';
            const storageKey = `bakesmart:catalog-cart:${email}`;
            const countItems = () => {
                try {
                    const items = JSON.parse(localStorage.getItem(storageKey) || '[]');
                    return Array.isArray(items)
                        ? items.reduce((total, item) => total + Math.max(1, Number(item?.quantity || 1)), 0)
                        : 0;
                } catch { return 0; }
            };
            const renderCount = explicitCount => {
                const count = Number.isFinite(Number(explicitCount)) ? Number(explicitCount) : countItems();
                document.querySelectorAll('[data-store-cart-count]').forEach(badge => {
                    badge.textContent = String(count);
                    badge.hidden = count <= 0;
                });
            };
            window.addEventListener('bakesmart:cart-updated', event => renderCount(event.detail?.count));
            window.addEventListener('storage', event => { if (event.key === storageKey) renderCount(); });
            renderCount();
        })();
    </script>
