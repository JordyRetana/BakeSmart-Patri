            const currentUserEmail = () => (document.body.dataset.userEmail || '').trim().toLowerCase();
            const cartKey = identity => `bakesmart:catalog-cart:${(identity || 'guest').trim().toLowerCase()}`;

            document.querySelectorAll('[data-store-cart-link]').forEach(link => {
