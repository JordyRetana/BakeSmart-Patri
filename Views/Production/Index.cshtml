@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Producción";
}

<div class="page-shell production-page">
    <div class="page-header production-header">
        <div>
            <h1 style="margin:0;display:flex;align-items:center;gap:.75rem;">
                <i class="fas fa-utensils" style="color:var(--primary);"></i>
                Producción
            </h1>
            <p class="text-muted" style="margin:.35rem 0 0;">Cola de producción y estado de pedidos.</p>
        </div>
        <span class="badge badge-info production-date-chip">
            <i class="fas fa-calendar-day"></i>
            @BusinessClock.Now.ToString("dddd, dd MMM", new System.Globalization.CultureInfo("es-CR"))
        </span>
    </div>

    <div class="production-content">
        <div class="grid grid-4 production-kpi-grid">
            <div class="card" style="text-align:center;">
                <i class="fas fa-clock" style="font-size:2rem;color:var(--warning);"></i>
                <div id="prodPendingCount" style="font-size:1.5rem;font-weight:700;">0</div>
                <div class="text-muted">Pendientes</div>
            </div>
            <div class="card" style="text-align:center;">
                <i class="fas fa-cog" style="font-size:2rem;color:var(--info);"></i>
                <div id="prodActiveCount" style="font-size:1.5rem;font-weight:700;">0</div>
                <div class="text-muted">En proceso</div>
            </div>
            <div class="card" style="text-align:center;">
                <i class="fas fa-check-circle" style="font-size:2rem;color:var(--success);"></i>
                <div id="prodDoneCount" style="font-size:1.5rem;font-weight:700;">0</div>
                <div class="text-muted">Completados</div>
            </div>
            <div class="card" style="text-align:center;">
                <i class="fas fa-exclamation-triangle" style="font-size:2rem;color:var(--danger);"></i>
                <div id="prodLateCount" style="font-size:1.5rem;font-weight:700;">0</div>
                <div class="text-muted">Atrasados</div>
            </div>
        </div>

        <div class="production-board">
            <div class="card production-lane production-lane--pending">
                <div class="card-header" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;">
                    <h3 style="margin:0;"><span style="width:12px;height:12px;background:var(--warning);display:inline-block;border-radius:50%;margin-right:.5rem;"></span>Pendientes</h3>
                    <span id="prodPendingBadge" class="badge badge-warning">0</span>
                </div>
                <div id="prodPendingList" class="kanban-column" style="display:flex;flex-direction:column;gap:1rem;">
                    <div class="text-muted">Cargando pedidos...</div>
                </div>
            </div>

            <div class="card production-lane production-lane--active">
                <div class="card-header" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;">
                    <h3 style="margin:0;"><span style="width:12px;height:12px;background:var(--info);display:inline-block;border-radius:50%;margin-right:.5rem;"></span>En producción</h3>
                    <span id="prodActiveBadge" class="badge badge-info">0</span>
                </div>
                <div id="prodActiveList" class="kanban-column" style="display:flex;flex-direction:column;gap:1rem;">
                    <div class="text-muted">Cargando pedidos...</div>
                </div>
            </div>

            <div class="card production-lane production-lane--done">
                <div class="card-header" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;">
                    <h3 style="margin:0;"><span style="width:12px;height:12px;background:var(--success);display:inline-block;border-radius:50%;margin-right:.5rem;"></span>Completados</h3>
                    <span id="prodDoneBadge" class="badge badge-success">0</span>
                </div>
                <div id="prodDoneList" style="display:flex;flex-direction:column;gap:1rem;">
                    <div class="text-muted">Cargando pedidos...</div>
                </div>
            </div>
        </div>

        <div class="card production-schedule-card">
            <div class="card-header" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem;">
                <h3 style="margin:0;display:flex;align-items:center;gap:.5rem;">
                    <i class="fas fa-clock" style="color:var(--primary);"></i>
                    Programacion del dia
                </h3>
                <span class="badge badge-info">@BusinessClock.Now.ToString("dd/MM/yyyy")</span>
            </div>
            <div id="productionSchedule" style="display:flex;flex-direction:column;gap:1rem;">
                <div class="text-muted">Cargando programacion...</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(() => {
    const store = window.BakeSmartStore;
    const today = new Date();
    today.setHours(0, 0, 0, 0);

    const statusMeta = {
        'Pendiente produccion': { badge: 'badge-warning', border: 'var(--warning)', action: 'Iniciar elaboración', icon: 'fa-play', progress: 20 },
        'Pendiente producción': { badge: 'badge-warning', border: 'var(--warning)', action: 'Iniciar elaboración', icon: 'fa-play', progress: 20 },
        'En produccion': { badge: 'badge-primary', border: 'var(--primary)', action: 'Marcar listo', icon: 'fa-check', progress: 65 },
        'En producción': { badge: 'badge-primary', border: 'var(--primary)', action: 'Marcar listo', icon: 'fa-check', progress: 65 },
        'Listo': { badge: 'badge-success', border: 'var(--success)', action: '', icon: 'fa-check', progress: 100 }
    };

    const setText = (id, value) => {
        const el = document.getElementById(id);
        if (el) el.textContent = value;
    };

    const fmtDate = value => new Date(value).toLocaleDateString('es-CR', { day: '2-digit', month: '2-digit' });
    const statusOf = order => order.estado || order.status || '';
    const displayStatus = value => value === 'En produccion' ? 'En producción' : value;
    const customerOf = order => order.cliente || order.customerName || '-';
    const deliveryOf = order => order.entrega || order.deliveryDate || new Date().toISOString();
    const itemOf = order => order.producto || order.products || 'Pedido personalizado';
    const materialReadiness = new Map();

    const materialPanel = orderId => {
        const readiness = materialReadiness.get(Number(orderId));
        if (!readiness) return '<div class="production-material-state is-loading"><i class="fas fa-spinner fa-spin"></i> Validando receta y materiales...</div>';
        const missingRecipes = readiness.missingRecipes || [];
        const materials = readiness.materials || [];
        if (missingRecipes.length > 0) {
            const missing = missingRecipes.map(escapeHtml).join(', ');
            return `<div class="production-material-state is-danger"><i class="fas fa-triangle-exclamation"></i><span><strong>Falta receta aprobada</strong><small>${missing} debe tener una receta revisada antes de producir.</small></span><a href="/Recipes">Abrir recetas</a></div>`;
        }
        if (!readiness.canStart) {
            const shortages = materials
                .filter(item => Number(item.availableQuantity || 0) < Number(item.requiredQuantity || 0))
                .map(item => {
                    const shortage = Math.max(0, Number(item.requiredQuantity || 0) - Number(item.availableQuantity || 0));
                    return `${escapeHtml(item.name)}: faltan ${shortage.toFixed(2).replace(/\.00$/, '')} ${escapeHtml(item.unit)}`;
                })
                .join(' · ');
            return `<div class="production-material-state is-warning"><i class="fas fa-boxes-stacked"></i><span><strong>Material insuficiente</strong><small>${shortages || 'Revise el inventario disponible.'}</small></span><a href="/Inventory">Ver inventario</a></div>`;
        }
        const count = materials.length;
        return `<div class="production-material-state is-ready"><i class="fas fa-circle-check"></i><span><strong>Materiales listos</strong><small>${count} ingrediente${count === 1 ? '' : 's'} validados para iniciar.</small></span></div>`;
    };

    function ticket(order, mode) {
        const status = statusOf(order);
        const meta = statusMeta[status] || statusMeta['Pendiente produccion'];
        const action = status === 'Listo'
            ? `<span class="badge badge-success"><i class="fas fa-box-check"></i> Listo para entrega</span>`
            : `<button class="btn btn-primary btn-sm" onclick="moveProductionOrder(${order.id})"><i class="fas ${meta.icon}"></i> ${meta.action}</button>`;

        return `
            <div class="card production-ticket" style="border-left:4px solid ${meta.border};">
                <div style="display:flex;justify-content:space-between;gap:.75rem;margin-bottom:.5rem;align-items:start;">
                    <strong>#${order.id} - ${customerOf(order)}</strong>
                    <span class="badge ${meta.badge}">${displayStatus(status)}</span>
                </div>
                <div>${itemOf(order)}</div>
                ${(order.isCustomOrder || String(order.notes || '').includes('Tipo de encargo')) ? '<span class="production-custom-tag"><i class="fas fa-wand-magic-sparkles"></i> Personalizado</span>' : ''}
                ${status !== 'Listo' ? materialPanel(order.id) : ''}
                ${mode !== 'pending' ? `<div class="progress" style="margin:.65rem 0;"><div class="progress-bar" style="width:${meta.progress}%;"></div></div>` : ''}
                <div style="display:flex;justify-content:space-between;align-items:center;gap:.75rem;margin-top:.65rem;">
                    <span class="text-muted"><i class="fas fa-calendar"></i> ${fmtDate(deliveryOf(order))}</span>
                    ${action}
                </div>
            </div>`;
    }

    function scheduleRow(order, index) {
        const hour = `${8 + index}:00`;
        return `
            <div class="production-schedule-row">
                <div class="production-schedule-time">${hour}</div>
                <div class="production-schedule-line"><span style="left:${Math.min(index * 18, 90)}%;"></span></div>
                <div class="production-schedule-label">#${order.id} - ${itemOf(order)}</div>
            </div>`;
    }

    async function loadMaterialReadiness(orders) {
        await Promise.all(orders.map(async order => {
            try {
                const response = await fetch(`/api/production/${order.id}/materials`, { headers: { Accept: 'application/json' } });
                if (response.ok) materialReadiness.set(Number(order.id), await response.json());
            } catch { /* El servidor conserva la validacion obligatoria al avanzar. */ }
        }));
    }

    async function renderProduction() {
        const orders = store.orders.list();
        const productionOrders = orders.filter(o => ['Pendiente produccion', 'Pendiente producción', 'En produccion', 'En producción', 'Listo'].includes(statusOf(o)));
        const pending = productionOrders.filter(o => ['Pendiente produccion', 'Pendiente producción'].includes(statusOf(o)));
        const active = productionOrders.filter(o => ['En produccion', 'En producción'].includes(statusOf(o)));
        const done = productionOrders.filter(o => statusOf(o) === 'Listo');
        const late = orders.filter(o => {
            const delivery = new Date(deliveryOf(o));
            delivery.setHours(0, 0, 0, 0);
            return productionOrders.includes(o) && delivery < today && statusOf(o) !== 'Listo';
        });

        setText('prodPendingCount', pending.length);
        setText('prodActiveCount', active.length);
        setText('prodDoneCount', done.length);
        setText('prodLateCount', late.length);
        setText('prodPendingBadge', pending.length);
        setText('prodActiveBadge', active.length);
        setText('prodDoneBadge', done.length);

        await loadMaterialReadiness([...pending, ...active]);

        document.getElementById('prodPendingList').innerHTML = pending.map(o => ticket(o, 'pending')).join('') || '<div class="text-muted">No hay pedidos pendientes.</div>';
        document.getElementById('prodActiveList').innerHTML = active.map(o => ticket(o, 'active')).join('') || '<div class="text-muted">No hay pedidos en producción.</div>';
        document.getElementById('prodDoneList').innerHTML = done.map(o => ticket(o, 'done')).join('') || '<div class="text-muted">No hay pedidos completados.</div>';
        document.getElementById('productionSchedule').innerHTML = productionOrders.slice(0, 5).map(scheduleRow).join('') || '<div class="text-muted">No hay programacion para hoy.</div>';
    }

    window.moveProductionOrder = orderId => {
        fetch(`/api/production/${orderId}/advance`, { method: 'POST', headers: { 'Content-Type': 'application/json' } }).then(async response => {
            if (!response.ok) {
                const error = await response.json().catch(() => null);
                throw new Error(error?.message || 'No se pudo avanzar la producción.');
            }
            const result = await response.json();
            const updatedOrder = store.orders.list().find(order => Number(order.id) === Number(orderId));
            if (updatedOrder) {
                updatedOrder.estado = result.status;
                updatedOrder.status = result.status;
            }
            await renderProduction();
            await store.refresh({ keys: ['orders'], force: true });
            await renderProduction();
            app.toast.success(`Pedido #${orderId} actualizado.`);
        }).catch(error => app.toast.error(error.message));
    };

    store.refresh({ keys: ['orders'], force: true }).then(() => renderProduction()).catch(error => app.toast.error(error.message));
})();
</script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/production-index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/production-page.css" asp-append-version="true" />
    <style>
        .production-custom-tag{display:inline-flex;align-items:center;gap:.35rem;margin-top:.5rem;padding:.28rem .55rem;border-radius:999px;background:#f8e8f4;color:#a1377e;font-size:.7rem;font-weight:800}
        .production-material-state{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:.55rem;margin-top:.7rem;padding:.65rem .75rem;border:1px solid;border-radius:.8rem;font-size:.76rem}.production-material-state span{display:grid;gap:.1rem}.production-material-state small{line-height:1.35}.production-material-state a{font-weight:800;white-space:nowrap}.production-material-state.is-loading{color:var(--text-muted);border-color:var(--border);background:var(--surface-soft)}.production-material-state.is-danger{color:#9f2d4f;border-color:#efbfd0;background:#fff2f7}.production-material-state.is-warning{color:#825812;border-color:#efd79c;background:#fff9e8}.production-material-state.is-ready{color:#25704c;border-color:#bde2cd;background:#effbf4}.production-material-state.is-danger a,.production-material-state.is-warning a{color:inherit}
        @@media(max-width:640px){.production-material-state{grid-template-columns:auto minmax(0,1fr)}.production-material-state a{grid-column:2}}
    </style>
}
