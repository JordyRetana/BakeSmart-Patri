@{ Layout = "~/Views/Shared/_Layout.cshtml"; ViewData["Title"] = "Seguridad de la cuenta"; var enabled = (ViewData["TwoFactorEnabled"] as bool?) == true; }
@section Styles { <link rel="stylesheet" href="~/css/pages/auth-security.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/pages/auth-security-enhancements.css" asp-append-version="true" /> }
<main class="account-security-page">
    <section class="account-security-hero">
        <span><i class="fas fa-user-shield"></i></span><div><p class="security-eyebrow">Protección de acceso</p><h1>Seguridad de la cuenta</h1><p>Proteja su cuenta con un código que cambia cada 30 segundos.</p></div>
    </section>
    <section class="account-security-card">
        @if (enabled)
        {
            <div class="security-enabled"><i class="fas fa-circle-check"></i><div><h2>Verificación en dos pasos activa</h2><p>Su contraseña por sí sola ya no permite iniciar sesión.</p></div></div>
        }
        else
        {
            <h2>Escanee el código QR</h2>
            <div class="security-setup-grid">
                <div class="security-qr-panel">
                    <img class="security-qr" src="@ViewData["QrCodeDataUri"]" alt="Código QR para configurar la autenticación de dos pasos" width="248" height="248" />
                    <p>En Google Authenticator, Microsoft Authenticator o Authy, pulse <strong>Agregar cuenta</strong> y escanee este código.</p>
                </div>
                <div class="security-setup-steps">
                    <ol><li>Escanee el QR con su aplicación autenticadora.</li><li>La aplicación mostrará un código de 6 dígitos.</li><li>Escríbalo abajo para confirmar la configuración.</li></ol>
                    <details class="security-manual"><summary>No puedo escanear el QR</summary><p>Introduzca esta clave manualmente en su aplicación:</p><div class="security-secret"><strong id="totpSecret">@ViewData["Secret"]</strong><button type="button" class="btn btn-outline security-copy" data-copy-target="totpSecret"><i class="fas fa-copy"></i> Copiar</button></div></details>
                </div>
            </div>
            <form method="post" action="/Account/EnableTwoFactor" class="security-enable-form">
                @Html.AntiForgeryToken()
                <input class="input security-code-input" name="code" inputmode="numeric" maxlength="6" pattern="[0-9]{6}" placeholder="000000" required />
                <button class="btn btn-primary" type="submit"><i class="fas fa-shield-halved"></i> Activar verificación</button>
            </form>
        }
        <a class="btn btn-outline" href="/Account/Profile">Volver a mi perfil</a>
    </section>
</main>
<script>
document.querySelector('[data-copy-target]')?.addEventListener('click', async function () {
    const value = document.getElementById(this.dataset.copyTarget)?.textContent?.trim();
    if (!value) return;
    await navigator.clipboard.writeText(value);
    this.innerHTML = '<i class="fas fa-check"></i> Copiada';
});
</script>
