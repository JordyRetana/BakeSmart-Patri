@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Nueva contraseña";
    var token = ViewData["ResetToken"]?.ToString() ?? "";
    var error = ViewData["ResetError"]?.ToString();
}

<div class="login-page-shell">
    <div class="card login-card">
        <div class="login-hero">
            <div class="login-logo-wrap"><i class="fas fa-shield-halved"></i></div>
            <h2 class="login-title">Cree una nueva contraseña</h2>
            <p class="text-muted login-subtitle">El enlace funciona una sola vez y vence después de 30 minutos.</p>
        </div>
        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="alert alert-error login-alert"><i class="fas fa-exclamation-circle"></i> @error</div>
        }
        <form method="post" action="/Account/ResetPassword" class="login-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="token" value="@token" />
            <div class="input-group">
                <label class="input-label" for="newPassword"><i class="fas fa-lock"></i> Nueva contraseña</label>
                <input id="newPassword" type="password" class="input" name="newPassword" minlength="8" required autocomplete="new-password" />
            </div>
            <div class="input-group">
                <label class="input-label" for="confirmPassword"><i class="fas fa-lock"></i> Confirmar contraseña</label>
                <input id="confirmPassword" type="password" class="input" name="confirmPassword" minlength="8" required autocomplete="new-password" />
            </div>
            <button type="submit" class="btn btn-primary btn-block btn-lg login-submit-btn"><i class="fas fa-key"></i> Guardar contraseña</button>
            <a href="/Account/Login" class="btn btn-outline btn-block">Volver al inicio de sesión</a>
        </form>
    </div>
</div>
