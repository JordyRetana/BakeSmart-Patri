@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Iniciar sesión";
}

@section Styles {
    <link rel="stylesheet" href="/css/pages/account-login.css?v=auth-redesign-20260717" />
    <link rel="stylesheet" href="~/css/pages/login-page.css" asp-append-version="true" />
}

<main class="login-page-shell">
    <section class="login-card">
        <aside class="login-hero">
            <img class="login-hero-photo" src="/img/products/cupcakes-decorados.jpg" alt="Cupcakes BakeSmart Patri" />
            <div class="login-hero-shade"></div>
            <div class="login-hero-content">
                <div class="login-logo-wrap"><img src="/img/logo.png" alt="BakeSmart Patri" /></div>
                <span class="login-eyebrow">Repostería artesanal</span>
                <h1>Bienvenido a BakeSmart Patri</h1>
                <div class="login-heart-divider"><span></span><i class="fas fa-heart"></i><span></span></div>
                <p>La plataforma creada para administrar tu negocio de repostería, gestionar pedidos y hacer crecer tu marca cada día.</p>
                <div class="login-feature-row" aria-label="Beneficios de BakeSmart Patri">
                    <span><i class="fas fa-cake-candles"></i>Pedidos<br />organizados</span>
                    <span><i class="fas fa-cube"></i>Inventario<br />controlado</span>
                    <span><i class="fas fa-chart-line"></i>Negocio<br />en crecimiento</span>
                </div>
            </div>
        </aside>

        <div class="login-form-panel">
            <div class="login-form-heading">
                <span>Acceso seguro</span>
                <h2>Iniciar sesión</h2>
                <p>Utiliza las credenciales asignadas a tu cuenta.</p>
            </div>

            @if (!string.IsNullOrEmpty(TempData["Toast"]?.ToString()))
            {
                <div class="alert alert-error login-alert"><i class="fas fa-circle-exclamation"></i><span>@TempData["Toast"]</span></div>
            }

            <form method="post" action="/Account/Login" class="login-form" id="loginForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@(ViewData["ReturnUrl"]?.ToString() ?? "")" />
                <div class="input-group">
                    <label class="input-label" for="loginEmail"><i class="fas fa-envelope"></i> Correo electrónico</label>
                    <input id="loginEmail" type="email" class="input" name="email" placeholder="tu@correo.com" required autocomplete="username" />
                </div>
                <div class="input-group">
                    <label class="input-label" for="loginPassword"><i class="fas fa-lock"></i> Contraseña</label>
                    <div class="password-field">
                        <input id="loginPassword" type="password" class="input" name="password" placeholder="Escribe tu contraseña" required autocomplete="current-password" />
                        <button type="button" class="password-toggle" data-password-toggle="loginPassword" aria-label="Mostrar contraseña"><i class="fas fa-eye"></i></button>
                    </div>
                </div>
                <div class="login-options">
                    <label class="login-remember"><input type="checkbox" name="remember" /><span>Recordarme</span></label>
                    <a href="/Account/ForgotPassword" class="login-forgot">¿Olvidaste tu contraseña?</a>
                </div>
                <button type="submit" class="btn btn-primary btn-block btn-lg login-submit-btn" id="loginSubmitBtn"><i class="fas fa-right-to-bracket"></i> Iniciar sesión</button>
                <div class="login-divider"><span>o</span></div>
                <button type="button" id="createCustomerAccountBtn" class="btn btn-outline btn-block login-create-btn" data-register-url="/Account/Register?returnUrl=@(Uri.EscapeDataString(ViewData["ReturnUrl"]?.ToString() ?? ""))"><i class="fas fa-user-plus"></i> Crear cuenta de cliente</button>
            </form>

            <div class="login-security-note"><i class="fas fa-shield-halved"></i><span><strong>Conexión protegida.</strong> Tus credenciales se validan de forma segura.</span></div>
        </div>
    </section>
</main>

@section Scripts {
<script>
(() => {
    document.querySelectorAll('[data-password-toggle]').forEach(toggle => {
        toggle.addEventListener('click', () => {
            const input = document.getElementById(toggle.dataset.passwordToggle);
            if (!input) return;
            input.type = input.type === 'password' ? 'text' : 'password';
            toggle.querySelector('i')?.classList.toggle('fa-eye-slash');
        });
    });

    const form = document.getElementById('loginForm');
    const button = document.getElementById('loginSubmitBtn');
    const createAccountButton = document.getElementById('createCustomerAccountBtn');
    createAccountButton?.addEventListener('click', () => {
        const target = createAccountButton.dataset.registerUrl || '/Account/Register';
        window.location.assign(target);
    });
    if (!form || !button) return;
    form.addEventListener('submit', () => {
        button.disabled = true;
        button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Ingresando...';
    }, { once: true });
})();
</script>
}
