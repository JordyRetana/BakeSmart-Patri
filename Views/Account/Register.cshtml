@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Crear cuenta";
}

@section Styles {
    <link rel="stylesheet" href="/css/pages/account-register.css?v=auth-redesign-20260718" />
}

<div class="auth-page-shell register-page">
    <div class="auth-card register-card">
        <aside class="auth-hero">
            <div class="auth-hero-decor auth-hero-decor--top"></div>
            <div class="auth-hero-decor auth-hero-decor--bottom"></div>
            <div class="auth-logo-wrap">
                <i class="fas fa-user-plus"></i>
            </div>
            <h2 class="auth-title">Crear cuenta</h2>
            <p class="auth-subtitle">Registra tu usuario para hacer pedidos, guardar tus favoritos y consultar el seguimiento de tus pedidos.</p>
            <div class="auth-benefits">
                <div><span><i class="fas fa-bag-shopping"></i></span><strong>Pedidos mas rapidos</strong><small>Guarda tus datos y compra en segundos.</small></div>
                <div><span><i class="fas fa-heart"></i></span><strong>Tus favoritos siempre contigo</strong><small>Guarda y organiza tus postres favoritos.</small></div>
                <div><span><i class="fas fa-truck-fast"></i></span><strong>Seguimiento en tiempo real</strong><small>Consulta el estado de tus pedidos facilmente.</small></div>
            </div>
        </aside>

        <section class="register-form-panel">
            <div class="register-heading">
                <h1><i class="fas fa-user"></i> Completa tus datos</h1>
                <p>Todos los campos principales son obligatorios.</p>
            </div>

            @if (!string.IsNullOrEmpty(TempData["Toast"]?.ToString()))
            {
                <div class="alert alert-error auth-alert">
                    <i class="fas fa-exclamation-circle"></i>
                    @TempData["Toast"]
                </div>
            }

            <form method="post" action="/Account/Register" class="register-form" id="registerForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                <div class="register-grid">
                    <div class="input-group">
                        <label class="input-label"><i class="fas fa-user"></i> Nombre</label>
                        <input class="input" name="firstName" placeholder="Ingresa tu nombre" required autocomplete="given-name" />
                    </div>

                    <div class="input-group">
                        <label class="input-label"><i class="fas fa-user"></i> Apellidos</label>
                        <input class="input" name="lastName" placeholder="Ingresa tus apellidos" required autocomplete="family-name" />
                    </div>

                    <div class="input-group">
                        <label class="input-label"><i class="fas fa-envelope"></i> Correo electronico</label>
                        <input class="input" type="email" name="email" placeholder="ejemplo@correo.com" required autocomplete="email" />
                    </div>

                    <div class="input-group">
                        <label class="input-label"><i class="fas fa-phone"></i> Telefono</label>
                        <input class="input" name="phone" placeholder="+506 6000 0000" autocomplete="tel" />
                    </div>

                    <div class="input-group register-full">
                        <label class="input-label"><i class="fas fa-location-dot"></i> Direccion</label>
                        <input class="input" name="addressLine" placeholder="Ingresa tu dirección completa" autocomplete="street-address" />
                    </div>

                    <div class="input-group">
                        <label class="input-label"><i class="fas fa-lock"></i> Contrasena</label>
                        <div class="password-field">
                            <input id="registerPassword" class="input" type="password" name="password" placeholder="Crea una contrasena" minlength="8" required autocomplete="new-password" />
                            <button type="button" class="password-toggle" data-password-toggle="registerPassword" aria-label="Mostrar contrasena"><i class="fas fa-eye"></i></button>
                        </div>
                    </div>

                    <div class="input-group">
                        <label class="input-label"><i class="fas fa-lock"></i> Confirmar contrasena</label>
                        <div class="password-field">
                            <input id="registerConfirmPassword" class="input" type="password" name="confirmPassword" placeholder="Confirma tu contrasena" minlength="8" required autocomplete="new-password" />
                            <button type="button" class="password-toggle" data-password-toggle="registerConfirmPassword" aria-label="Mostrar contrasena"><i class="fas fa-eye"></i></button>
                        </div>
                    </div>
                </div>

                <div class="password-strength" data-password-strength data-level="empty" aria-live="polite">
                    <div class="password-strength__labels"><span>Seguridad de la contrasena:</span><b data-strength-label>Debil</b><b>Media</b><b>Fuerte</b></div>
                    <div class="password-strength__bars"><span></span><span></span><span></span></div>
                </div>

                <button type="submit" class="btn btn-primary btn-block btn-lg register-submit-btn" id="registerSubmitBtn">
                    <i class="fas fa-user-check"></i>
                    Crear cuenta
                </button>
            </form>
        </section>
    </div>

    <div class="auth-help-card">
        <div class="auth-help-row">
            <i class="fas fa-shield-halved"></i>
            <div>
                <p><strong>Seguridad:</strong> La contrasena se guarda hasheada con PBKDF2.</p>
                <p class="text-muted">El usuario nuevo queda registrado con rol Cliente.</p>
            </div>
        </div>
        <a href="/Account/Login" class="btn btn-outline btn-sm">Ya tengo cuenta</a>
    </div>
</div>

@section Scripts {
<script>
(() => {
    document.querySelectorAll('[data-password-toggle]').forEach(toggle => {
        toggle.addEventListener('click', () => {
            const input = document.getElementById(toggle.dataset.passwordToggle);
            if (!input) return;
            input.type = input.type === 'password' ? 'text' : 'password';
            toggle.querySelector('i')?.classList.toggle('fa-eye-slash');
        });
    });

    const passwordInput = document.getElementById('registerPassword');
    const strength = document.querySelector('[data-password-strength]');
    const strengthLabel = document.querySelector('[data-strength-label]');
    const calculateStrength = value => {
        let score = 0;
        if (value.length >= 8) score++;
        if (value.length >= 12) score++;
        if (/[A-Z]/.test(value) && /[a-z]/.test(value)) score++;
        if (/\d/.test(value)) score++;
        if (/[^A-Za-z0-9]/.test(value)) score++;
        if (!value) return { level: 'empty', text: 'Debil' };
        if (score >= 4) return { level: 'strong', text: 'Fuerte' };
        if (score >= 2) return { level: 'medium', text: 'Media' };
        return { level: 'weak', text: 'Debil' };
    };

    if (passwordInput && strength) {
        passwordInput.addEventListener('input', () => {
            const result = calculateStrength(passwordInput.value);
            strength.dataset.level = result.level;
            if (strengthLabel) strengthLabel.textContent = result.text;
        });
    }

    const form = document.getElementById('registerForm');
    const submit = document.getElementById('registerSubmitBtn');
    if (!form || !submit) return;

    form.addEventListener('submit', () => {
        submit.disabled = true;
        submit.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Creando cuenta...';
    }, { once: true });
})();
</script>
}
