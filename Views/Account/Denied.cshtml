@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Acceso restringido";
    Context.Response.StatusCode = 403;
}

@section Styles { <link rel="stylesheet" href="~/css/pages/error-pages.css" asp-append-version="true" /> }

<main class="bs-error" aria-labelledby="deniedTitle">
    <section class="bs-error-card">
        <div class="bs-error-symbol" aria-hidden="true"><i class="fas fa-lock"></i></div>
        <span class="bs-error-code">Error 403</span>
        <h1 id="deniedTitle">Esta sección está restringida</h1>
        <p>Tu cuenta no tiene acceso a esta página. Puedes volver al inicio o entrar con otra cuenta que tenga el permiso necesario.</p>
        <div class="bs-error-actions">
            <a class="bs-error-button bs-error-button-primary" href="/"><i class="fas fa-house" aria-hidden="true"></i> Ir al inicio</a>
            <a class="bs-error-button bs-error-button-secondary" href="/Account/Login"><i class="fas fa-right-to-bracket" aria-hidden="true"></i> Cambiar de cuenta</a>
        </div>
        @if (User?.Identity?.IsAuthenticated ?? false)
        {
            <div class="bs-error-note"><i class="fas fa-circle-info" aria-hidden="true"></i><span>Sesión actual: <strong>@User.Identity.Name</strong>. Si necesitas acceso, consulta con un administrador.</span></div>
        }
    </section>
</main>
