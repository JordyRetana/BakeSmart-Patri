@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "No pudimos completar la solicitud";
}

@section Styles { <link rel="stylesheet" href="~/css/pages/error-pages.css" asp-append-version="true" /> }

<main class="error-page" aria-labelledby="errorTitle">
    <section class="error-card">
        <div class="error-visual error-visual--server" aria-hidden="true"><span>500</span><i class="fas fa-cookie-bite"></i></div>
        <div class="error-copy">
            <span class="error-eyebrow">Error temporal</span>
            <h1 id="errorTitle">No pudimos completar la solicitud</h1>
            <p>Algo falló mientras procesábamos esta página. Puedes intentarlo nuevamente o volver a un lugar seguro.</p>
            <div class="error-actions">
                <button type="button" class="btn btn-primary" onclick="window.location.reload()"><i class="fas fa-rotate-right"></i> Intentar de nuevo</button>
                <a class="btn btn-outline" href="/"><i class="fas fa-house"></i> Volver al inicio</a>
            </div>
            <small><i class="fas fa-circle-info"></i> Si vuelve a ocurrir, anota la hora y la acción que estabas realizando.</small>
        </div>
    </section>
</main>
