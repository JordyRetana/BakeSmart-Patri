@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "No pudimos abrir esta página";
}

@section Styles { <link rel="stylesheet" href="~/css/pages/error-pages.css" asp-append-version="true" /> }

<main class="bs-error" aria-labelledby="errorTitle">
    <section class="bs-error-card">
        <div class="bs-error-symbol" aria-hidden="true"><i class="fas fa-cookie-bite"></i></div>
        <span class="bs-error-code">Error 500</span>
        <h1 id="errorTitle">Algo salió mal</h1>
        <p>No pudimos completar esta solicitud. Espera un momento e inténtalo de nuevo. Si continúa, anota qué estabas haciendo para que podamos revisarlo.</p>
        <div class="bs-error-actions">
            <button type="button" class="bs-error-button bs-error-button-primary" onclick="window.location.reload()"><i class="fas fa-rotate-right" aria-hidden="true"></i> Intentar de nuevo</button>
            <a class="bs-error-button bs-error-button-secondary" href="/"><i class="fas fa-house" aria-hidden="true"></i> Ir al inicio</a>
        </div>
    </section>
</main>
