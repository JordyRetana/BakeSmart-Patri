@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Detalle de pedido";
    var orderId = ViewContext.RouteData.Values["id"]?.ToString() ?? "";
    var paymentToStart = Context.Request.Query["pay"].ToString();
    var orderJson = ViewData["OrderJson"]?.ToString() ?? "null";
}

<div class="page-shell order-details-page">
    <div class="card">
        <div class="section-title">
            <div>
                <h2 id="orderTitle">Pedido</h2>
                <div id="orderSubtitle" class="sub">Cargando informacion del pedido...</div>
            </div>
            <div style="display:flex;gap:10px;flex-wrap:wrap;">
                <a class="btn btn-secondary" href="/Orders/Edit/@orderId"><i class="fas fa-pen"></i> Modificar pedido</a>
                <a class="btn" href="/Client/Orders">Volver a mis pedidos</a>
            </div>
        </div>

        <div class="hr"></div>

        <div class="grid grid-3">
            <div class="card soft">
                <div class="muted" style="font-weight:900;">Estado</div>
                <div style="margin-top:10px;"><span id="orderStatus" class="pill">-</span></div>
            </div>
            <div class="card soft">
                <div class="muted" style="font-weight:900;">Entrega</div>
                <div id="orderDelivery" style="margin-top:10px;font-weight:950;font-size:18px;">-</div>
            </div>
            <div class="card soft">
                <div class="muted" style="font-weight:900;">Total</div>
                <div id="orderTotal" style="margin-top:10px;font-weight:950;font-size:18px;">-</div>
            </div>
        </div>

        <div class="grid grid-2" style="margin-top:16px;">
            <div class="card soft">
                <div style="font-weight:950;">Productos</div>
                <div id="orderProducts" class="muted" style="margin-top:8px;font-weight:700;line-height:1.6;">-</div>
            </div>
            <div class="card soft" id="orderCustomizationCard" hidden>
                <div style="font-weight:950;"><i class="fas fa-wand-magic-sparkles" style="color:var(--secondary);"></i> Personalización solicitada</div>
                <div id="orderCustomization" class="muted" style="margin-top:8px;font-weight:700;line-height:1.7;white-space:pre-line;"></div>
            </div>
            <div class="card soft">
                <div style="font-weight:950;">Acciones</div>
                <div class="muted" style="margin-top:8px;font-weight:700;line-height:1.6;">@(User.IsInRole("Cliente") ? "Consulta el avance y la ubicación de tu entrega." : "Actualiza estado, fecha y notas desde editar.")</div>
                <div style="margin-top:12px;">
                    <a class="btn btn-secondary" href="@(User.IsInRole("Cliente") ? $"/Client/Track?id={orderId}" : "/Production")">@(User.IsInRole("Cliente") ? "Ver seguimiento" : "Ver producción")</a>
                    <span id="securePaymentAction"></span>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    window.addEventListener('DOMContentLoaded', () => {
        const orderId = Number('@orderId');
        const serverOrder = @Html.Raw(orderJson);
        const paymentToStart = '@paymentToStart';
        const money = value => `₡${Number(value || 0).toLocaleString('es-CR')}`;

        const renderOrder = order => {
            if (!order) {
                document.getElementById('orderSubtitle').textContent = 'No se encontro el pedido solicitado.';
                return;
            }

            document.getElementById('orderTitle').textContent = `Pedido #${order.id}`;
            document.getElementById('orderSubtitle').textContent = `${order.cliente || order.customerName || '-'} - ${order.paymentMethod || '-'}`;
            document.getElementById('orderStatus').textContent = order.estado || order.status || '-';
            document.getElementById('orderDelivery').textContent = order.entrega || order.deliveryDate || '-';
            document.getElementById('orderTotal').textContent = money(order.total);
            document.getElementById('orderProducts').textContent = order.producto || order.products || 'Sin detalle';
            if (order.isCustomOrder || String(order.notes || '').includes('Tipo de encargo')) {
                document.getElementById('orderCustomizationCard').hidden = false;
                document.getElementById('orderCustomization').textContent = String(order.notes || 'Pedido personalizado');
            }
            if (paymentToStart) openSecurePayment(paymentToStart);
        };
        if (serverOrder) {
            renderOrder(serverOrder);
            return;
        }
        window.BakeSmartStore.refresh().then(() => renderOrder(window.BakeSmartStore.orders.list().find(row => Number(row.id) === orderId))).catch(error => {
            document.getElementById('orderSubtitle').textContent = error.message;
        });
    });

    async function openSecurePayment(method) {
        const isPayPal = String(method).toLowerCase().includes('paypal');
        const paymentAction = document.getElementById('securePaymentAction');
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'btn btn-primary';
        button.innerHTML = isPayPal ? '<i class="fab fa-paypal"></i> Pagar con PayPal' : '<i class="fas fa-credit-card"></i> Pagar con tarjeta';
        paymentAction.replaceChildren(button);
        const begin = async () => {
            button.disabled = true;
            button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Abriendo pago seguro…';
            try {
                const response = await fetch(isPayPal ? '/api/payments/paypal/checkout' : '/api/payments/stripe/checkout', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ orderIds: [Number('@orderId')] })
                });
                const result = await response.json();
                if (!response.ok || !result.url) throw new Error(result.message || 'No se pudo iniciar el pago seguro.');
                window.location.assign(result.url);
            } catch (error) {
                app.toast.error(error.message || 'No se pudo iniciar el pago seguro.');
                button.disabled = false;
                button.innerHTML = isPayPal ? '<i class="fab fa-paypal"></i> Reintentar PayPal' : '<i class="fas fa-credit-card"></i> Reintentar tarjeta';
            }
        };
        button.addEventListener('click', begin);
        await begin();
    }
</script>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/orders-form.css" asp-append-version="true" />
}
