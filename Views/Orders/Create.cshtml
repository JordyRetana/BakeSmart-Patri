@model BakeSmartPatri.Models.OrderCreateViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Nuevo Pedido";
    var selectedProduct = Context.Request.Query["product"].ToString();
    var culture = new System.Globalization.CultureInfo("es-CR");
}

<div class="page-shell order-form-page">
    @if (TempData["ToastError"] is string errorMessage && !string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-error" role="alert">@errorMessage</div>
    }
    @if (TempData["ToastSuccess"] is string successMessage && !string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success" role="status">@successMessage</div>
    }
    <div class="order-create-hero">
        <span class="order-create-eyebrow"><i class="fas fa-wand-magic-sparkles"></i> PEDIDO PERSONALIZADO</span>
        <h1><i class="fas fa-cake-candles"></i> Crea un pedido a medida</h1>
        <p>Elige el tipo de encargo, personalízalo y confirma la entrega. El pago se realiza con el método que prefieras.</p>
        <div class="order-create-steps"><span><b>1</b> Diseño</span><span><b>2</b> Entrega</span><span><b>3</b> Pago</span></div>
    </div>

    <form method="post" action="/Orders/Create" id="orderForm">
        @Html.AntiForgeryToken()

        <div class="card" style="margin-bottom:1.5rem;">
            <h3>Informacion del cliente</h3>
            <div class="grid grid-2" style="gap: clamp(0.75rem, 1.2vw, 1.25rem);">
                <div class="input-group">
                    <label class="input-label"><i class="fas fa-user"></i> Nombre completo *</label>
                    <input id="orderCustomerName" type="text" class="input" name="cliente" required placeholder="Nombre del cliente">
                </div>
                <div class="input-group">
                    <label class="input-label"><i class="fas fa-phone"></i> Telefono *</label>
                    <input id="orderCustomerPhone" type="tel" class="input" name="telefono" required placeholder="+506 8888-8888">
                </div>
                <div class="input-group">
                    <label class="input-label"><i class="fas fa-envelope"></i> Email *</label>
                    <input id="orderCustomerEmail" type="email" class="input" name="email" required placeholder="cliente@email.com">
                </div>
                <div class="input-group">
                    <label class="input-label"><i class="fas fa-id-card"></i> Cedula / Pasaporte</label>
                    <input id="orderCustomerIdentification" type="text" class="input" name="identificacion" placeholder="Identificacion">
                </div>
            </div>
        </div>

        <div class="card" style="margin-bottom:1.5rem;">
            <h3>Diseña tu encargo</h3>
            <p class="text-muted order-section-copy">El tipo de encargo activa los detalles de pastelería. La base disponible se usa para calcular el precio real del pedido.</p>
            <div class="grid grid-2">
                <div class="input-group">
                    <label class="input-label"><i class="fas fa-cake-candles"></i> Tipo de pedido *</label>
                    <select class="input" name="tipoPedido" required id="orderType">
                        <option value="Queque de chocolate personalizado">Queque de chocolate personalizado</option>
                        <option value="Queque de zanahoria personalizado">Queque de zanahoria personalizado</option>
                        <option value="Queque red velvet personalizado">Queque red velvet personalizado</option>
                        <option value="Queque de vainilla personalizado">Queque de vainilla personalizado</option>
                        <option value="Queque de tres leches personalizado">Queque de tres leches personalizado</option>
                        <option value="Pastel de cumpleaños personalizado">Pastel de cumpleaños personalizado</option>
                        <option value="Pastel temático infantil">Pastel temático infantil</option>
                        <option value="Pastel de boda o aniversario">Pastel de boda o aniversario</option>
                        <option value="Cupcakes personalizados">Cupcakes personalizados</option>
                        <option value="Mesa dulce para evento">Mesa dulce para evento</option>
                        <option value="Pedido especial de repostería">Pedido especial de repostería</option>
                    </select>
                </div>
                <div class="input-group">
                    <label class="input-label"><i class="fas fa-box-open"></i> Base disponible para cotización *</label>
                    <select class="input" name="productoId" required id="productSelect">
                        <option value="">Seleccionar producto</option>
                        @foreach (var product in Model.Products)
                        {
                            var isSelected = selectedProduct == product.Id.ToString();
                            <option value="@product.Id" data-price="@product.UnitPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)" selected="@isSelected">
                                @product.Name - @product.UnitPrice.ToString("C0", culture)
                            </option>
                        }
                    </select>
                </div>

                <div class="input-group">
                    <label class="input-label"><i class="fas fa-users"></i> Tamaño / porciones</label>
                    <input type="text" class="input" name="tamano" placeholder="Ej. 20 porciones, 24 cm">
                </div>

                <div class="input-group">
                    <label class="input-label"><i class="fas fa-calendar"></i> Fecha de entrega *</label>
                    <input type="date" class="input" name="entrega" required min="@DateTime.Now.ToString("yyyy-MM-dd")">
                </div>

                <div class="input-group">
                    <label class="input-label"><i class="fas fa-clock"></i> Hora de entrega</label>
                    <input type="time" class="input" name="hora" value="14:00">
                </div>
            </div>
        </div>

        <div class="card" style="margin-bottom:1.5rem;">
            <h3>Personalización del queque</h3>
            <div class="grid grid-2">
                <div class="input-group">
                    <label class="input-label"><i class="fas fa-paint-brush"></i> Sabor / relleno</label>
                    <input type="text" class="input" name="sabor" placeholder="Chocolate, vainilla, dulce de leche...">
                </div>
                <div class="input-group">
                    <label class="input-label"><i class="fas fa-palette"></i> Color de decoracion</label>
                    <input type="color" class="input" name="color" style="height:45px;padding:.25rem;" value="#ec4899">
                </div>
            </div>
            <div class="input-group">
                <label class="input-label"><i class="fas fa-message"></i> Mensaje personalizado</label>
                <input type="text" class="input" name="mensaje" placeholder="Mensaje para el pedido">
            </div>
            <div class="input-group">
                <label class="input-label"><i class="fas fa-clipboard"></i> Notas adicionales</label>
                <textarea class="input" name="notas" rows="3" placeholder="Alergias, instrucciones especiales, etc."></textarea>
            </div>
        </div>

        <div class="card" style="margin-bottom:1.5rem;" id="deliverySection">
            <h3>Entrega y pago</h3>
            <div class="grid grid-2">
                <div class="input-group">
                    <label class="input-label"><i class="fas fa-truck"></i> Metodo de entrega</label>
                    <select class="input" name="metodoEntrega" id="metodoEntrega">
                        <option value="domicilio">A domicilio</option>
                        <option value="retiro">Retiro en tienda</option>
                    </select>
                </div>
                <div class="input-group">
                    <label class="input-label"><i class="fas fa-credit-card"></i> Método de pago</label>
                    <select class="input" name="metodoPago" id="paymentMethod">
                        <option value="PayPal">PayPal</option>
                        <option value="SINPE">SINPE Móvil</option>
                        <option value="Transferencia">Transferencia bancaria</option>
                        <option value="Efectivo">Efectivo al retirar</option>
                        <option value="Pendiente">Pago pendiente</option>
                    </select>
                </div>
            </div>
            <p class="text-muted order-payment-note" id="paymentNote"><i class="fab fa-paypal"></i> PayPal abre su pasarela oficial después de crear el pedido.</p>

            <div id="deliveryMapBlock" style="margin-top:1rem;">
                <div class="input-group" style="margin-bottom:1rem;">
                    <label class="input-label"><i class="fas fa-house"></i> Usar dirección guardada</label>
                    <select class="input" id="savedAddressSelect">
                        <option value="">Seleccionar en el mapa una nueva ubicacion</option>
                    </select>
                </div>
                <input type="hidden" name="direccion" id="direccion" />
                <input type="hidden" name="latitudEntrega" id="latitudEntrega" />
                <input type="hidden" name="longitudEntrega" id="longitudEntrega" />
                <input type="hidden" name="customerAddressId" id="customerAddressId" />
                <div class="input-group" style="margin-bottom:1rem;">
                    <label class="input-label"><i class="fas fa-signs-post"></i> Referencia de entrega</label>
                    <input type="text" class="input" name="referenciaEntrega" placeholder="Ej: casa blanca, porton negro, apto 3B" />
                </div>
                <div id="orderMapPicker"></div>
            </div>
        </div>

        <div class="card" style="background:var(--gradient-primary);color:white;margin-bottom:1.5rem;">
            <h3 style="color:white;">Resumen del pedido</h3>
            <div style="display:flex;flex-direction:column;gap:.5rem;">
                <div style="display:flex;justify-content:space-between;"><span>Subtotal:</span><span id="subtotal">₡0</span></div>
                <div style="display:flex;justify-content:space-between;"><span>Descuento cliente frecuente:</span><span id="discount">₡0</span></div>
                <div style="display:flex;justify-content:space-between;"><span>IVA:</span><span id="tax">₡0</span></div>
                <div style="display:flex;justify-content:space-between;font-size:1.25rem;font-weight:700;margin-top:.5rem;padding-top:.5rem;border-top:1px solid rgba(255,255,255,.3);">
                    <span>Total:</span>
                    <span id="total">₡0</span>
                </div>
            </div>
        </div>

        <div style="display:flex;gap:1rem;justify-content:flex-end;flex-wrap:wrap;">
            <a href="/Orders" class="btn btn-outline btn-lg"><i class="fas fa-times"></i> Cancelar</a>
            <button type="submit" class="btn btn-primary btn-lg"><i class="fas fa-lock"></i> Crear pedido y continuar</button>
        </div>
    </form>
</div>

<script src="~/js/bakesmart-map-picker.js" asp-append-version="true"></script>
<script>
    let orderMapPicker;
    let orderCustomerProfile = null;

    async function initOrderMap() {
        await BakeSmartStore.refresh();
        const config = BakeSmartStore.pos.config();
        try { orderCustomerProfile = await BakeSmartStore.loadProfile(); } catch (_) { orderCustomerProfile = null; }

        if (orderCustomerProfile) {
            document.getElementById('orderCustomerName').value = `${orderCustomerProfile.firstName || ''} ${orderCustomerProfile.lastName || ''}`.trim();
            document.getElementById('orderCustomerPhone').value = orderCustomerProfile.phone || '';
            document.getElementById('orderCustomerEmail').value = orderCustomerProfile.email || '';
            document.getElementById('orderCustomerIdentification').value = orderCustomerProfile.identification || orderCustomerProfile.idNumber || '';
            ['orderCustomerName', 'orderCustomerPhone', 'orderCustomerEmail'].forEach(id => document.getElementById(id).readOnly = true);
        }

        orderMapPicker = await BakeSmartMapPicker.create('orderMapPicker', {
            address: '',
            lat: config.originLatitude,
            lng: config.originLongitude,
            onChange(values) {
                document.getElementById('direccion').value = values.address || '';
                document.getElementById('latitudEntrega').value = values.lat ?? '';
                document.getElementById('longitudEntrega').value = values.lng ?? '';
                document.getElementById('customerAddressId').value = '';
                document.getElementById('savedAddressSelect').value = '';
            }
        });

        try {
            const addresses = await BakeSmartStore.loadAddresses();
            const select = document.getElementById('savedAddressSelect');
            addresses.forEach(item => {
                const option = document.createElement('option');
                option.value = String(item.id);
                option.textContent = `${item.label} - ${item.addressLine}`;
                option.dataset.address = item.addressLine;
                option.dataset.lat = item.latitude ?? '';
                option.dataset.lng = item.longitude ?? '';
                select.appendChild(option);
            });
        } catch (_) { /* optional for staff without saved addresses */ }
    }

    function toggleDeliveryMode() {
        const isPickup = document.getElementById('metodoEntrega').value === 'retiro';
        document.getElementById('deliveryMapBlock').style.display = isPickup ? 'none' : 'block';
    }

    document.getElementById('savedAddressSelect').addEventListener('change', (event) => {
        const option = event.target.selectedOptions[0];
        if (!option || !option.value) return;
        orderMapPicker.setValues({
            address: option.dataset.address,
            lat: option.dataset.lat,
            lng: option.dataset.lng
        });
        document.getElementById('direccion').value = option.dataset.address;
        document.getElementById('latitudEntrega').value = option.dataset.lat;
        document.getElementById('longitudEntrega').value = option.dataset.lng;
        document.getElementById('customerAddressId').value = option.value;
    });

    function updateSummary() {
        const productSelect = document.getElementById('productSelect');
        const selectedOption = productSelect.options[productSelect.selectedIndex];
        const subtotal = Number(selectedOption?.dataset.price || 0);
        const config = BakeSmartStore.pos.config();
        const discountRate = orderCustomerProfile?.isFrequent ? Number(config.frequentCustomerDiscount || 0) : 0;
        const discount = Math.round(subtotal * discountRate * 100) / 100;
        const tax = Math.round((subtotal - discount) * Number(config.iva || 0) * 100) / 100;
        const total = subtotal - discount + tax;

        document.getElementById('subtotal').textContent = `₡${subtotal.toLocaleString('es-CR')}`;
        document.getElementById('discount').textContent = discount > 0 ? `-₡${discount.toLocaleString('es-CR')}` : '₡0';
        document.getElementById('tax').textContent = `₡${tax.toLocaleString('es-CR')}`;
        document.getElementById('total').textContent = `₡${total.toLocaleString('es-CR')}`;
    }

    document.getElementById('productSelect').addEventListener('change', updateSummary);
    document.getElementById('paymentMethod').addEventListener('change', event => {
        const method = String(event.target.value || '').toLowerCase();
        document.getElementById('paymentNote').innerHTML = method.includes('paypal')
            ? '<i class="fab fa-paypal"></i> Serás redirigido a PayPal para autorizar el cobro seguro.'
            : '<i class="fas fa-receipt"></i> El pago se registrará con el método seleccionado al confirmar el pedido.';
    });
    document.getElementById('metodoEntrega').addEventListener('change', () => {
        updateSummary();
        toggleDeliveryMode();
    });
    document.getElementById('orderForm').addEventListener('submit', function (e) {
        const isPickup = document.getElementById('metodoEntrega').value === 'retiro';
        if (!isPickup && orderMapPicker) {
            orderMapPicker.applyToFields({
                address: 'direccion',
                lat: 'latitudEntrega',
                lng: 'longitudEntrega'
            });
        }
        if (!isPickup && orderMapPicker && !orderMapPicker.isValid()) {
            e.preventDefault();
            app.toast.error('Seleccione una ubicacion valida de entrega en el mapa.');
            return;
        }

        const errors = app.validate.form(this, {
            cliente: ['required'],
            telefono: ['required'],
            email: ['required', 'email'],
            productoId: ['required'],
            entrega: ['required']
        });

        if (errors.length > 0) {
            e.preventDefault();
            errors.forEach(error => app.toast.error(error.message));
        }
    });

    window.addEventListener('DOMContentLoaded', () => {
        initOrderMap().then(() => {
            updateSummary();
            toggleDeliveryMode();
        }).catch(error => app.toast.error(error.message));
    });
</script>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/orders-form.css" asp-append-version="true" />
}
