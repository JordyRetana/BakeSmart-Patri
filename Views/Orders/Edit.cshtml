@{ Layout = "~/Views/Shared/_Layout.cshtml"; ViewData["Title"] = "Modificar pedido"; var orderJson = ViewData["OrderJson"]?.ToString() ?? "null"; }
@section Styles { <link rel="stylesheet" href="~/css/pages/orders-form.css" asp-append-version="true" /> }
<main class="page-shell order-form-page"><section class="card order-edit-card"><span class="eyebrow">Tu pedido</span><h1 id="editTitle">Modificar pedido</h1><p class="muted">Puedes actualizar la fecha o las indicaciones mientras el pedido no haya entrado a producción.</p><div class="hr"></div>
<form method="post" id="editOrderForm"><div class="field"><label for="entrega">Fecha de entrega</label><input class="input" name="entrega" id="entrega" type="date" required /></div><div class="field" style="margin-top:16px"><label for="notas">Indicaciones del pedido</label><textarea class="input" name="notas" id="notas" rows="6" placeholder="Mensaje, decoración o notas para el pedido"></textarea></div><div style="margin-top:20px;display:flex;gap:12px;flex-wrap:wrap"><button class="btn btn-primary" type="submit"><i class="fas fa-check"></i> Guardar cambios</button><a class="btn btn-secondary" id="cancelEdit">Cancelar</a></div></form></section></main>
<script>window.addEventListener('DOMContentLoaded',()=>{const o=@Html.Raw(orderJson);document.getElementById('editTitle').textContent=`Modificar pedido #${o.id}`;document.getElementById('editOrderForm').action=`/Orders/Edit/${o.id}`;document.getElementById('entrega').value=o.entrega||'';document.getElementById('notas').value=o.notes||'';document.getElementById('cancelEdit').href=`/Orders/Details/${o.id}`;});</script>
