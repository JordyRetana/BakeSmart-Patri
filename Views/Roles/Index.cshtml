@{ Layout = "~/Views/Shared/_Layout.cshtml"; ViewData["Title"] = "Roles"; }
@section Styles { <link rel="stylesheet" href="~/css/pages/roles-index.css" asp-append-version="true" /> }
<main class="page-shell roles-page">
 <header class="roles-hero"><div><span class="roles-eyebrow">Seguridad</span><h1><i class="fas fa-shield-halved"></i> Roles y permisos</h1><p>Resumen claro de accesos por perfil, sin listas infinitas ni tarjetas vacías.</p></div><a class="btn btn-outline" href="/Users"><i class="fas fa-arrow-left"></i> Usuarios</a></header>
 <section class="roles-layout"><aside class="roles-list" id="rolesGrid"></aside><article class="card roles-detail-card"><div class="roles-matrix-head"><div><span class="roles-eyebrow">Detalle</span><h2 id="roleDetailTitle">Seleccione un rol</h2></div><span class="badge badge-info" id="rolesFeatureCount">0 permisos</span></div><div id="roleDetailPermissions" class="role-permissions-large"></div></article></section>
 <article class="card roles-matrix-card"><div class="roles-matrix-head"><div><span class="roles-eyebrow">Matriz</span><h2>Funcionalidades por rol</h2></div></div><div class="table-container"><table class="table roles-matrix-table"><thead id="rolesMatrixHead"></thead><tbody id="rolesMatrix"></tbody></table></div></article>
</main>
@section Scripts { <script>
(()=>{const decode=v=>{try{return decodeURIComponent(escape(String(v??'')))}catch{return String(v??'')}};const clean=v=>decode(v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));let roles=[],selectedRole=null;
const fallback=n=>{const x=String(n||'').toLowerCase();if(x.includes('admin'))return ['Dashboard','Pedidos','Producción','Inventario','Punto de venta','Reportes','Bitácora','Configuración','Usuarios','Roles','Contabilidad','Marketing','Catálogo','Perfil'];if(x.includes('super'))return ['Dashboard','Pedidos','Producción','Inventario','Punto de venta','Reportes','Bitácora','Contabilidad','Marketing','Perfil'];if(x.includes('caj'))return ['Dashboard','Pedidos','Punto de venta','Catálogo','Perfil'];if(x.includes('repost'))return ['Dashboard','Producción','Inventario','Pedidos','Perfil'];if(x.includes('cliente'))return ['Catálogo','Pedido rápido','Mis pedidos','Seguimiento','Perfil'];return ['Perfil'];};
function selectRole(name){selectedRole=roles.find(r=>r.name===name)||roles[0];renderRoles();renderDetail()}window.selectRole=selectRole;
function renderRoles(){rolesGrid.innerHTML=roles.map(r=>`<button type="button" class="role-card ${selectedRole?.name===r.name?'role-card--active':''}" onclick="selectRole('${clean(r.name)}')"><span><i class="fas fa-user-shield"></i></span><div><strong>${clean(r.name)}</strong><small>${clean(String(r.description||'Acceso del sistema').replace(/Operacion/g,'Operación').replace(/Produccion/g,'Producción'))}</small></div><b>${r.permissions.length}</b></button>`).join('')}
function renderDetail(){if(!selectedRole)return;roleDetailTitle.textContent=selectedRole.name;rolesFeatureCount.textContent=`${selectedRole.permissions.length} permisos`;roleDetailPermissions.innerHTML=selectedRole.permissions.map(p=>`<span><i class="fas fa-check"></i>${clean(p)}</span>`).join('')}
function renderMatrix(){const features=[...new Set(roles.flatMap(r=>r.permissions))].sort();rolesMatrixHead.innerHTML=`<tr><th>Funcionalidad</th>${roles.map(r=>`<th>${clean(r.name)}</th>`).join('')}</tr>`;rolesMatrix.innerHTML=features.map(f=>`<tr><td><strong>${clean(f)}</strong></td>${roles.map(r=>`<td>${r.permissions.includes(f)?'<i class="fas fa-check"></i>':'<i class="fas fa-minus"></i>'}</td>`).join('')}</tr>`).join('')}
async function init(){await BakeSmartStore.refresh();roles=BakeSmartStore.roles.list().map(r=>({...r,name:decode(r.name),description:decode(r.description),permissions:(Array.isArray(r.permissions)&&r.permissions.length?r.permissions:fallback(r.name)).map(decode)}));selectedRole=roles[0]||null;renderRoles();renderDetail();renderMatrix()}init().catch(e=>app.toast.error(e.message));})();
</script> }
